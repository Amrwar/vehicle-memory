{
  "name": "@carnet/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/generated/client/index.js"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "build": "prisma generate && tsc --build",
    "format": "prisma format",
    "validate": "prisma validate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
