// ---------------------------------------------------------------------------
// Carnet — data model
//
// Five bounded contexts, documented in docs/02-design/01-domain-model.md:
//   IDENTITY   organisations, users, access, audit      (cross-cutting)
//   PASSPORT   vehicles and their permanent history     (GLOBAL, not tenant-scoped)
//   WORKSHOP   customers, bookings, jobs, inspections   (tenant-scoped)
//   INVENTORY  parts, stock, suppliers, purchasing      (tenant-scoped, Phase 2)
//   FINANCE    invoices, payments, ledger               (tenant-scoped, Phase 3)
//
// The load-bearing decision: PASSPORT models are NOT tenant-scoped. A vehicle
// is serviced by a workshop, never owned by one. See ADR-0004.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

// Connection URL lives in prisma.config.ts (Prisma 7 moved it out of the
// schema). The runtime client receives a driver adapter; see src/client.ts.
datasource db {
  provider = "postgresql"
}

// ===========================================================================
// IDENTITY
// ===========================================================================

model Organization {
  id                     String    @id @default(cuid())
  slug                   String    @unique
  name                   String
  legalName              String?
  taxNumber              String?
  email                  String?
  phone                  String?
  website                String?
  /// Chosen at sign-up; currency, locale and timezone follow it unless changed.
  country                String    @default("GB")
  baseCurrency           String    @default("GBP")
  timezone               String    @default("Europe/London")
  locale                 String    @default("en-GB")
  plan                   OrgPlan   @default(CORE)
  /// Where the workshop stands with us: a state read from these four dates. Phase 31.
  trialEndsAt            DateTime?
  subscribedAt           DateTime?
  suspendedAt            DateTime?
  cancelledAt            DateTime?
  /// The subscription, billed through the payment provider. Phase 32.6. The
  /// provider's references, what it last said, the card it holds, and when
  /// the workshop accepted the terms that say the card is charged.
  billingProvider        String?
  billingCustomerRef     String?
  billingSubscriptionRef String?   @unique
  billingCheckoutRef     String?   @unique
  billingStatus          String?
  billingCardBrand       String?
  billingCardLast4       String?
  currentPeriodEnd       DateTime?
  billingPayload         Json?
  termsAcceptedAt        DateTime?
  termsVersion           String?
  trialReminderSentAt    DateTime?
  logoUrl                String?
  // Work exceeding an approved estimate by more than this fraction needs
  // re-approval. FR-812.
  reapprovalThresholdPct Decimal   @default(10.0) @db.Decimal(5, 2)
  /// Model tokens the assistant may spend in a calendar month. Beyond it the
  /// assistant keeps working on the plain, composed text. FR-4904.
  assistantTokenBudget   Int       @default(1000000)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  locations           Location[]
  memberships         Membership[]
  customers           Customer[]
  bookings            Booking[]
  jobs                Job[]
  jobTypes            JobType[]
  tags                Tag[]
  serviceItems        ServiceItem[]
  inspectionTemplates InspectionTemplate[]
  estimates           Estimate[]
  invoices            Invoice[]
  payments            Payment[]
  creditNotes         CreditNote[]
  refunds             Refund[]
  supplierPayments    SupplierPayment[]
  payrollRuns         PayrollRun[]
  fleetAgreements     FleetAgreement[]
  taxRates            TaxRate[]
  sequences           DocumentSequence[]
  messages            MessageLog[]
  conversations       Conversation[]
  messageAttachments  MessageAttachment[]
  messageTemplates    MessageTemplate[]
  servicePackages     ServicePackage[]
  auditLogs           AuditLog[]
  vehicleAccess       VehicleAccessGrant[]
  recordedEvents      VehicleEvent[]
  odometerReadings    OdometerReading[]
  serviceSchedules    ServiceSchedule[]
  productCategories   ProductCategory[]
  products            Product[]
  warehouses          Warehouse[]
  stockMovements      StockMovement[]
  suppliers           Supplier[]
  purchaseRequests    PurchaseRequest[]
  purchaseOrders      PurchaseOrder[]
  supplierBills       SupplierBill[]
  accounts            Account[]
  fiscalPeriods       FiscalPeriod[]
  journalEntries      JournalEntry[]
  employees           Employee[]
  payRates            PayRate[]
  attendance          AttendanceRecord[]
  timesheets          Timesheet[]
  absences            Absence[]
  certifications      Certification[]
  commissionSchemes   CommissionScheme[]
  commissionAwards    CommissionAward[]
  stockTransfers      StockTransfer[]
  invitations         Invitation[]
  counterSales        CounterSale[]
  tillSessions        TillSession[]
  expenses            Expense[]
  bankAccounts        BankAccount[]
  automationRules     AutomationRule[]
  campaigns           Campaign[]
  warranties          Warranty[]
  skills              Skill[]
  workingPatterns     WorkingPattern[]
  partFitments        PartFitment[]
  syncedActions       SyncedAction[]
  reviewRequests      ReviewRequest[]
  loyaltyEntries      LoyaltyEntry[]
  referrals           Referral[]
  inboundMessages     InboundMessage[]
  suppressedAddresses SuppressedAddress[]
  deliveryEvents      DeliveryEvent[]
  vehicleClaims       VehicleClaim[]
  apiKeys             ApiKey[]
  assistantExchanges  AssistantExchange[]
  vehicleDocuments    VehicleDocument[]
  giftCards           GiftCard[]
  giftCardEntries     GiftCardEntry[]
  deposits            Deposit[]
  depositMovements    DepositMovement[]
  paymentAttempts     PaymentAttempt[]
  imports             ImportBatch[]
  signatures          Signature[]
  vehicleChecks       VehicleCheck[]
  keyEvents           KeyEvent[]

  @@index([isActive])
  @@index([billingCustomerRef])
  @@map("organizations")
}

enum OrgPlan {
  CORE
  COMPLETE
  GROUP
}

model Location {
  id                 String   @id @default(cuid())
  orgId              String
  name               String
  code               String
  addressLine1       String?
  addressLine2       String?
  locality           String?
  region             String?
  postcode           String?
  country            String   @default("GB")
  phone              String?
  timezone           String?
  // Total technician hours the site can absorb per day. FR-509.
  dailyCapacityHours Decimal  @default(40.0) @db.Decimal(6, 2)
  /// Opening hours as minutes from midnight. Planning places work inside
  /// them; before Phase 19 eight to six was assumed in code. FR-4603.
  opensAtMinute      Int      @default(480)
  closesAtMinute     Int      @default(1080)
  isDefault          Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bays         Bay[]
  bookings     Booking[]
  jobs         Job[]
  memberships  Membership[]
  warehouses   Warehouse[]
  employees    Employee[]
  attendance   AttendanceRecord[]
  counterSales CounterSale[]
  tillSessions TillSession[]
  giftCards    GiftCard[]
  expenses     Expense[]

  @@unique([orgId, code])
  @@index([orgId, isActive])
  @@map("locations")
}

model Bay {
  id         String   @id @default(cuid())
  locationId String
  name       String
  code       String
  sortOrder  Int      @default(0)
  // A lift bay cannot take a truck; a diagnostic bay needs the scan tool.
  capability String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  bookings Booking[]
  jobs     Job[]

  @@unique([locationId, code])
  @@index([locationId, isActive])
  @@map("bays")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  phone           String?
  avatarUrl       String?
  locale          String    @default("en-GB")
  /// The language they chose: en, fr or ar. Null until they choose. Phase 37.5.
  language        String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships              Membership[]
  sessions                 Session[]
  auditLogs                AuditLog[]
  jobsCreated              Job[]                @relation("JobCreatedBy")
  jobTechnicians           JobTechnician[]
  jobStatusEvents          JobStatusEvent[]
  jobNotes                 JobNote[]
  jobAttachments           JobAttachment[]
  jobTasksDone             JobTask[]
  jobFollowUps             JobFollowUp[]
  timeEntries              TimeEntry[]
  qualityChecks            QualityCheck[]
  inspections              Inspection[]
  estimatesCreated         Estimate[]
  paymentsRecorded         Payment[]
  refundsRecorded          Refund[]             @relation("RefundRecorder")
  depositsTaken            Deposit[]            @relation("DepositTaker")
  depositMovements         DepositMovement[]
  supplierPaymentsRecorded SupplierPayment[]    @relation("SupplierPaymentRecorder")
  payrollRunsCreated       PayrollRun[]         @relation("PayrollRunCreator")
  apiKeysCreated           ApiKey[]             @relation("ApiKeyCreator")
  assistantExchanges       AssistantExchange[]
  documentsUploaded        VehicleDocument[]    @relation("DocumentUploader")
  signaturesCaptured       Signature[]          @relation("SignatureCapturedBy")
  vehicleChecks            VehicleCheck[]       @relation("CheckPerformedBy")
  keyEvents                KeyEvent[]           @relation("KeyEventBy")
  conversationsAssigned    Conversation[]       @relation("ConversationAssignee")
  messagesSent             MessageLog[]         @relation("MessageSentBy")
  messageTemplates         MessageTemplate[]
  preferredBy              Customer[]           @relation("PreferredTechnician")
  bookingTechnician        Booking[]
  // Passport
  ownedVehicles            VehicleOwnership[]
  vehicleAccess            VehicleAccessGrant[]
  vehicleEvents            VehicleEvent[]
  passportShares           PassportShare[]
  // Portal identity: a customer record in a workshop may point at this user
  customerProfiles         Customer[]
  purchaseApprovals        PurchaseRequest[]    @relation("PurchaseApprovedBy")
  // Phase 4
  employeeRecord           Employee?
  invitationsSent          Invitation[]         @relation("InvitationSender")
  counterSales             CounterSale[]        @relation("CounterSaleSeller")
  tillSessions             TillSession[]        @relation("TillOperator")
  expensesApproved         Expense[]            @relation("ExpenseApprover")
  timesheetApprovals       Timesheet[]          @relation("TimesheetApprover")
  transfersDispatched      StockTransfer[]      @relation("TransferDispatcher")
  transfersReceived        StockTransfer[]      @relation("TransferReceiver")
  warranties               Warranty[]
  warrantyClaims           WarrantyClaim[]
  skillAssessments         EmployeeSkill[]
  partFitments             PartFitment[]
  syncedActions            SyncedAction[]
  reviewsResolved          ReviewRequest[]
  loyaltyEntries           LoyaltyEntry[]
  inboundHandled           InboundMessage[]
  authTokens               AuthToken[]
  suppressionsLifted       SuppressedAddress[]
  vehicleClaims            VehicleClaim[]
  claimsDecided            VehicleClaim[]       @relation("ClaimDecider")
  giftCardsSold            GiftCard[]
  giftCardEntries          GiftCardEntry[]
  paymentAttemptsStarted   PaymentAttempt[]     @relation("PaymentAttemptStarter")
  importBatches            ImportBatch[]

  @@index([isActive])
  @@map("users")
}

/// A user's membership of one organisation, carrying their role there.
model Membership {
  id         String   @id @default(cuid())
  userId     String
  orgId      String
  role       Role
  locationId String?
  isActive   Boolean  @default(true)
  // Charge-out rate used for labour cost when this member clocks time.
  costRate   Decimal? @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([userId, orgId])
  @@index([orgId, role, isActive])
  @@map("memberships")
}

enum Role {
  OWNER
  MANAGER
  SERVICE_ADVISOR
  TECHNICIAN
  BOOKKEEPER
  CUSTOMER
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  orgId     String?
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Rate-limiting evidence for authentication. FR-110.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  succeeded Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

/// Immutable record of every state-changing action. FR-109.
model AuditLog {
  id          String   @id @default(cuid())
  orgId       String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actor User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Transactional outbox. Domain events are written in the same transaction as
/// the state change, then dispatched by the worker. At-least-once, so every
/// handler must be idempotent. ADR-0007.
model OutboxEvent {
  id          String    @id @default(cuid())
  orgId       String?
  type        String
  payload     Json
  availableAt DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([processedAt, availableAt])
  @@map("outbox_events")
}

// ===========================================================================
// PASSPORT  —  global, not tenant-scoped
// ===========================================================================

/// A physical vehicle. Exists independently of any owner or workshop.
/// Globally unique by VIN. ADR-0004.
model Vehicle {
  id                    String        @id @default(cuid())
  vin                   String        @unique
  vinValid              Boolean       @default(true)
  registration          String?
  registrationRegion    String?
  registrationExpiresAt DateTime?
  make                  String?
  model                 String?
  variant               String?
  year                  Int?
  engineCode            String?
  engineCapacityCc      Int?
  fuelType              FuelType?
  transmission          Transmission?
  bodyType              String?
  driveType             String?
  colour                String?
  seats                 Int?
  firstRegisteredAt     DateTime?

  /// Denormalised chain head: the hash of the most recent event. Lets us
  /// append without reading the whole chain. FR-403.
  chainHead      String?
  eventCount     Int       @default(0)
  lastOdometerKm Int?
  lastOdometerAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events           VehicleEvent[]
  ownerships       VehicleOwnership[]
  odometerReadings OdometerReading[]
  accessGrants     VehicleAccessGrant[]
  shares           PassportShare[]
  recalls          VehicleRecall[]
  bookings         Booking[]
  jobs             Job[]
  serviceSchedules ServiceSchedule[]
  warranties       Warranty[]
  claims           VehicleClaim[]
  documents        VehicleDocument[]

  @@index([registration])
  @@index([make, model, year])
  @@map("vehicles")
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
  LPG
  HYDROGEN
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
  CVT
  DCT
  OTHER
}

/// One immutable fact about a vehicle. APPEND ONLY.
/// There is no update path in the application. Corrections append a
/// superseding event. FR-401, FR-406.
model VehicleEvent {
  id        String @id @default(cuid())
  vehicleId String
  /// Position in this vehicle's chain, starting at 1.
  sequence  Int

  type         VehicleEventType
  occurredAt   DateTime
  recordedAt   DateTime          @default(now())
  verification VerificationLevel @default(WORKSHOP_RECORDED)

  title      String
  summary    String?
  /// Type-specific structured detail. Shape per type is documented in
  /// docs/02-design/02-data-model.md section 4.
  payload    Json
  odometerKm Int?

  recordedByOrgId  String?
  recordedByUserId String?
  /// Soft link to the job that produced this event. Nullable because events
  /// also arrive from owners and authorities.
  jobRef           String?

  /// Hash chain. hash = H(salt | vehicleId | sequence | type | occurredAt |
  /// canonical(payload) | prevHash). FR-403.
  hash     String
  prevHash String?

  supersedesId   String? @unique
  supersededById String? @unique

  vehicle        Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  recordedByOrg  Organization?            @relation(fields: [recordedByOrgId], references: [id], onDelete: SetNull)
  recordedByUser User?                    @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  supersedes     VehicleEvent?            @relation("EventSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   VehicleEvent?            @relation("EventSupersession")
  attachments    VehicleEventAttachment[]

  @@unique([vehicleId, sequence])
  @@index([vehicleId, occurredAt(sort: Desc)])
  @@index([vehicleId, type])
  @@index([recordedByOrgId])
  @@map("vehicle_events")
}

enum VehicleEventType {
  OWNERSHIP_TRANSFER
  REGISTRATION_CHANGE
  MILEAGE_READING
  SERVICE
  REPAIR
  PART_FITTED
  INSPECTION
  TIRE
  ACCIDENT
  RECALL_NOTICE
  RECALL_PERFORMED
  MODIFICATION
  MAINTENANCE
  IMPORT
  WRITE_OFF
  NOTE
}

/// How much weight a reader should give an event. FR-407.
enum VerificationLevel {
  SELF_REPORTED // the owner said so
  WORKSHOP_RECORDED // a workshop entered it during work
  WORKSHOP_VERIFIED // a workshop entered it with photographic evidence
  AUTHORITY // a registry, manufacturer or insurer supplied it
}

model VehicleEventAttachment {
  id        String         @id @default(cuid())
  eventId   String
  kind      AttachmentKind @default(PHOTO)
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  caption   String?
  createdAt DateTime       @default(now())

  event VehicleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("vehicle_event_attachments")
}

enum AttachmentKind {
  PHOTO
  DOCUMENT
  REPORT
  VIDEO
}

/// Who held the vehicle, and when. At most one open row per vehicle. V5.
model VehicleOwnership {
  id          String    @id @default(cuid())
  vehicleId   String
  /// Portal identity of the owner, when they have an account.
  ownerUserId String?
  /// Display name, kept even when no account exists and after erasure.
  ownerName   String?
  ownerKind   OwnerKind @default(PRIVATE)
  startedAt   DateTime
  endedAt     DateTime?
  source      String?
  createdAt   DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  owner   User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([vehicleId, startedAt])
  @@index([ownerUserId])
  @@map("vehicle_ownerships")
}

enum OwnerKind {
  PRIVATE
  COMPANY
  FLEET
  DEALER
  FINANCE
}

/// Every odometer reading ever taken, including implausible ones.
/// An impossible reading is evidence, not an error. FR-307, invariant V7.
model OdometerReading {
  id              String          @id @default(cuid())
  vehicleId       String
  km              Int
  readAt          DateTime
  source          OdometerSource  @default(WORKSHOP)
  anomaly         OdometerAnomaly @default(NONE)
  jobRef          String?
  recordedByOrgId String?
  createdAt       DateTime        @default(now())

  vehicle Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  org     Organization? @relation(fields: [recordedByOrgId], references: [id], onDelete: SetNull)

  @@index([vehicleId, readAt(sort: Desc)])
  @@index([anomaly])
  @@map("odometer_readings")
}

enum OdometerSource {
  WORKSHOP
  OWNER
  INSPECTION
  AUTHORITY
  TELEMATICS
}

enum OdometerAnomaly {
  NONE
  DECREASE
  IMPLAUSIBLE_RATE
}

/// A workshop's or person's right to read or write a vehicle's passport.
/// A workshop earns write access by servicing the vehicle. FR-409.
model VehicleAccessGrant {
  id          String      @id @default(cuid())
  vehicleId   String
  orgId       String?
  userId      String?
  scope       AccessScope @default(READ)
  reason      GrantReason @default(SERVICED)
  grantedAt   DateTime    @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  /// A previous owner may read only the period they owned the vehicle. FR-412.
  visibleFrom DateTime?
  visibleTo   DateTime?

  vehicle Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  org     Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, orgId])
  @@index([vehicleId, userId])
  @@map("vehicle_access_grants")
}

enum AccessScope {
  READ
  WRITE
  OWNER
}

enum GrantReason {
  OWNED
  SERVICED
  OWNER_GRANTED
  PROSPECTIVE_BUYER
  AUTHORITY
}

/// An anonymous, expiring, revocable link to one vehicle's passport. FR-409.
model PassportShare {
  id              String    @id @default(cuid())
  vehicleId       String
  tokenHash       String    @unique
  label           String?
  createdByUserId String?
  expiresAt       DateTime
  revokedAt       DateTime?
  openCount       Int       @default(0)
  lastOpenedAt    DateTime?
  createdAt       DateTime  @default(now())

  vehicle   Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy User?                 @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  accesses  PassportShareAccess[]

  @@index([vehicleId])
  @@map("passport_shares")
}

/// Every read of a shared passport, visible to the owner. FR-410.
model PassportShareAccess {
  id        String   @id @default(cuid())
  shareId   String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  share PassportShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId, createdAt])
  @@map("passport_share_accesses")
}

model Recall {
  id           String         @id @default(cuid())
  campaignRef  String         @unique
  manufacturer String
  title        String
  description  String?
  severity     RecallSeverity @default(STANDARD)
  issuedAt     DateTime
  createdAt    DateTime       @default(now())

  vehicles VehicleRecall[]

  @@index([manufacturer])
  @@map("recalls")
}

enum RecallSeverity {
  STANDARD
  SAFETY
  CRITICAL
}

model VehicleRecall {
  id               String       @id @default(cuid())
  vehicleId        String
  recallId         String
  status           RecallStatus @default(OPEN)
  completedAt      DateTime?
  completedByOrgId String?
  createdAt        DateTime     @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  recall  Recall  @relation(fields: [recallId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, recallId])
  @@index([status])
  @@map("vehicle_recalls")
}

enum RecallStatus {
  OPEN
  COMPLETED
  NOT_APPLICABLE
}

// ===========================================================================
// WORKSHOP  —  tenant-scoped
// ===========================================================================

model Customer {
  id                        String       @id @default(cuid())
  orgId                     String
  kind                      CustomerKind @default(INDIVIDUAL)
  displayName               String
  firstName                 String?
  lastName                  String?
  companyName               String?
  taxNumber                 String?
  email                     String?
  mobile                    String?
  phone                     String?
  addressLine1              String?
  addressLine2              String?
  locality                  String?
  region                    String?
  postcode                  String?
  country                   String       @default("GB")
  sourceOfBusiness          String?
  notes                     String?
  marketingEmailConsent     Boolean      @default(false)
  marketingSmsConsent       Boolean      @default(false)
  /// When a marketing message last went out. The floor between sends is
  /// measured from here, so a campaign cannot pester somebody a rule already
  /// contacted this week.
  lastMarketedAt            DateTime?
  /// Portal login, when the customer has one.
  portalUserId              String?
  /// The technician this customer asks for. Preselected on a new job. FR-4706.
  preferredTechnicianUserId String?
  isActive                  Boolean      @default(true)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  org                 Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  portalUser          User?               @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  preferredTechnician User?               @relation("PreferredTechnician", fields: [preferredTechnicianUserId], references: [id], onDelete: SetNull)
  bookings            Booking[]
  counterSales        CounterSale[]
  jobs                Job[]               @relation("JobCustomer")
  billedJobs          Job[]               @relation("JobBillTo")
  invoices            Invoice[]
  payments            Payment[]
  refunds             Refund[]
  fleetAgreement      FleetAgreement?
  consentChanges      ConsentChange[]
  campaignRecipients  CampaignRecipient[]
  reviewRequests      ReviewRequest[]
  loyaltyEntries      LoyaltyEntry[]
  referralsMade       Referral[]          @relation("ReferralsMade")
  referralsUsed       Referral[]          @relation("ReferralsUsed")
  giftCardsBought     GiftCard[]
  deposits            Deposit[]
  inboundMessages     InboundMessage[]
  conversations       Conversation[]
  paymentAttempts     PaymentAttempt[]

  @@index([orgId, isActive])
  @@index([orgId, mobile])
  @@index([orgId, email])
  @@index([orgId, displayName])
  @@map("customers")
}

enum CustomerKind {
  INDIVIDUAL
  COMPANY
}

model JobType {
  id                   String   @id @default(cuid())
  orgId                String
  name                 String
  colour               String   @default("#2a41d8")
  requiresQualityCheck Boolean  @default(false)
  defaultHours         Decimal? @db.Decimal(6, 2)
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)

  org    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jobs   JobJobType[]
  skills JobTypeSkill[]
  packages ServicePackage[]

  @@unique([orgId, name])
  @@map("job_types")
}

model Tag {
  id     String @id @default(cuid())
  orgId  String
  name   String
  colour String @default("#6b7488")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jobs JobTag[]

  @@unique([orgId, name])
  @@map("tags")
}

/// Catalogue of standard services with book times. FR-615.
model ServiceItem {
  id           String   @id @default(cuid())
  orgId        String
  code         String
  name         String
  description  String?
  category     String?
  defaultHours Decimal  @default(1.0) @db.Decimal(6, 2)
  defaultPrice Decimal  @default(0) @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, code])
  @@map("service_items")
}

/// A piece of work priced and described as one thing: labour, parts, a
/// checklist, a duration, a price and an interval. A job or a booking made
/// from one starts with all of it on it. Phase 37.
model ServicePackage {
  id              String   @id @default(cuid())
  orgId           String
  code            String
  name            String
  description     String?
  jobTypeId       String?
  durationMinutes Int      @default(60)
  /// A fixed price for the whole package; null means the lines add up.
  price           Decimal? @db.Decimal(12, 2)
  intervalMonths  Int?
  intervalKm      Int?
  /// Offered to customers booking online.
  bookable        Boolean  @default(true)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org      Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jobType  JobType?              @relation(fields: [jobTypeId], references: [id], onDelete: SetNull)
  lines    ServicePackageLine[]
  checks   ServicePackageCheck[]
  jobs     Job[]
  bookings Booking[]

  @@unique([orgId, code])
  @@index([orgId, sortOrder])
  @@map("service_packages")
}

model ServicePackageLine {
  id          String   @id @default(cuid())
  packageId   String
  kind        LineKind @default(LABOUR)
  description String
  /// Hours for labour, units for a part, 1 for a fee.
  quantity    Decimal  @default(1) @db.Decimal(10, 3)
  /// The rate for labour, the unit price for a part, the amount for a fee.
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  productId   String?
  sortOrder   Int      @default(0)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([packageId, sortOrder])
  @@map("service_package_lines")
}

/// One thing to do and tick on a job made from the package.
model ServicePackageCheck {
  id        String  @id @default(cuid())
  packageId String
  title     String
  detail    String?
  sortOrder Int     @default(0)

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, sortOrder])
  @@map("service_package_checks")
}

model Booking {
  id             String        @id @default(cuid())
  orgId          String
  locationId     String
  customerId     String
  vehicleId      String
  bayId          String?
  technicianId   String?
  status         BookingStatus @default(SCHEDULED)
  startAt        DateTime
  endAt          DateTime
  estimatedHours Decimal       @default(1.0) @db.Decimal(6, 2)
  description    String
  notes          String?
  source         BookingSource @default(PHONE)
  jobId          String?       @unique
  /// The package this booking is for, if any. Phase 37.
  packageId      String?
  reminderSentAt DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location   Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle    Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bay        Bay?         @relation(fields: [bayId], references: [id], onDelete: SetNull)
  technician User?        @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  job        Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  package    ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([orgId, startAt])
  @@index([locationId, startAt])
  @@index([bayId, startAt])
  @@index([technicianId, startAt])
  @@index([status])
  @@map("bookings")
}

enum BookingStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  CONVERTED
  NO_SHOW
  CANCELLED
}

enum BookingSource {
  PHONE
  WALK_IN
  PORTAL
  ONLINE
  RECALL
  REMINDER
  /// Written to the diary by accepting the day's proposed plan.
  PLAN
}

/// The central aggregate. Everything in the workshop hangs off the Job.
model Job {
  id               String    @id @default(cuid())
  orgId            String
  locationId       String
  /// Per-organisation sequential job number.
  number           Int
  customerId       String
  vehicleId        String
  bayId            String?
  billToCustomerId String?
  status           JobStatus @default(DRAFT)

  shortDescription    String
  details             String?
  diagnosis           String?
  customerOrderNumber String?
  sourceOfBusiness    String?

  odometerInKm   Int?
  odometerOutKm  Int?
  estimatedHours Decimal? @db.Decimal(6, 2)

  receivedAt   DateTime?
  promisedAt   DateTime?
  pickUpAt     DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  /// When the customer took the car back. Phase 35.
  collectedAt  DateTime?
  /// The package this job was made from, if any. Phase 37.
  packageId    String?
  invoicedAt   DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  courtesyVehicleNote String?
  createdByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location  Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customer  Customer     @relation("JobCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  billTo    Customer?    @relation("JobBillTo", fields: [billToCustomerId], references: [id], onDelete: SetNull)
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bay       Bay?         @relation(fields: [bayId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("JobCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  booking          Booking?
  technicians      JobTechnician[]
  jobTypes         JobJobType[]
  tags             JobTag[]
  statusEvents     JobStatusEvent[]
  tasks            JobTask[]
  labourLines      JobLabourLine[]
  partLines        JobPartLine[]
  feeLines         JobFeeLine[]
  notes            JobNote[]
  attachments      JobAttachment[]
  timeEntries      TimeEntry[]
  qualityChecks    QualityCheck[]
  followUps        JobFollowUp[]
  inspections      Inspection[]
  estimates        Estimate[]
  invoices         Invoice[]
  invoiceLines     InvoiceLine[]     @relation("InvoiceLineJob")
  purchaseRequests PurchaseRequest[]
  warranties       Warranty[]
  warrantyClaims   WarrantyClaim[]   @relation("ClaimRemedy")
  reviewRequest    ReviewRequest?
  deposits         Deposit[]
  loyaltyEntries   LoyaltyEntry[]
  referrals        Referral[]
  inboundMessages  InboundMessage[]
  checks           VehicleCheck[]
  keyEvents        KeyEvent[]
  signatures       Signature[]
  conversation     Conversation?
  package          ServicePackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([vehicleId])
  @@index([customerId])
  @@index([locationId, status])
  @@map("jobs")
}

/// FR-603. Transitions enforced in packages/core/src/job/lifecycle.ts.
enum JobStatus {
  DRAFT
  BOOKED
  RECEIVED
  INSPECTING
  DIAGNOSED
  ESTIMATED
  AWAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  QUALITY_CHECK
  COMPLETED
  INVOICED
  PAID
  CANCELLED
}

model JobTechnician {
  id        String  @id @default(cuid())
  jobId     String
  userId    String
  isPrimary Boolean @default(false)

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@map("job_technicians")
}

model JobJobType {
  jobId     String
  jobTypeId String

  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobType JobType @relation(fields: [jobTypeId], references: [id], onDelete: Cascade)

  @@id([jobId, jobTypeId])
  @@map("job_job_types")
}

model JobTag {
  jobId String
  tagId String

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([jobId, tagId])
  @@map("job_tags")
}

/// The progress trail shown on the job screen. FR-604.
model JobStatusEvent {
  id          String     @id @default(cuid())
  jobId       String
  fromStatus  JobStatus?
  toStatus    JobStatus
  actorUserId String?
  note        String?
  createdAt   DateTime   @default(now())

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@map("job_status_events")
}

model JobTask {
  id           String    @id @default(cuid())
  jobId        String
  title        String
  detail       String?
  sortOrder    Int       @default(0)
  isDone       Boolean   @default(false)
  doneByUserId String?
  doneAt       DateTime?
  createdAt    DateTime  @default(now())

  job    Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  doneBy User? @relation(fields: [doneByUserId], references: [id], onDelete: SetNull)

  @@index([jobId, sortOrder])
  @@map("job_tasks")
}

/// Charged time. Distinct from TimeEntry, which is worked time. See the
/// ubiquitous language in docs/02-design/01-domain-model.md section 2.
model JobLabourLine {
  id          String   @id @default(cuid())
  jobId       String
  description String
  hours       Decimal  @db.Decimal(8, 2)
  rate        Decimal  @db.Decimal(10, 2)
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  taxRateId   String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@map("job_labour_lines")
}

model JobPartLine {
  id          String         @id @default(cuid())
  jobId       String
  productId   String?
  partNumber  String?
  description String
  quantity    Decimal        @default(1) @db.Decimal(10, 3)
  unitCost    Decimal        @default(0) @db.Decimal(12, 4)
  unitPrice   Decimal        @default(0) @db.Decimal(12, 2)
  discountPct Decimal        @default(0) @db.Decimal(5, 2)
  taxRateId   String?
  status      PartLineStatus @default(REQUESTED)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())

  job          Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product      Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxRate      TaxRate?           @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  reservations StockReservation[]

  @@index([jobId])
  @@map("job_part_lines")
}

enum PartLineStatus {
  REQUESTED
  RESERVED
  ON_ORDER
  FITTED
  RETURNED
}

model JobFeeLine {
  id          String  @id @default(cuid())
  jobId       String
  description String
  amount      Decimal @db.Decimal(12, 2)
  taxRateId   String?
  sortOrder   Int     @default(0)

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@map("job_fee_lines")
}

model JobNote {
  id                String   @id @default(cuid())
  jobId             String
  authorUserId      String?
  body              String
  isCustomerVisible Boolean  @default(false)
  createdAt         DateTime @default(now())

  job    Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@map("job_notes")
}

model JobAttachment {
  id                String         @id @default(cuid())
  jobId             String
  kind              AttachmentKind @default(PHOTO)
  url               String
  filename          String
  mimeType          String
  sizeBytes         Int
  caption           String?
  isCustomerVisible Boolean        @default(true)
  uploadedByUserId  String?
  /// Taken at check-in or check-out, so it belongs to that record. Phase 35.
  checkId           String?
  createdAt         DateTime       @default(now())

  job        Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  check      VehicleCheck? @relation(fields: [checkId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([checkId])
  @@map("job_attachments")
}

/// Worked time, used for labour cost. Distinct from JobLabourLine.
/// A technician has at most one open entry. Invariant J5.
model TimeEntry {
  id         String    @id @default(cuid())
  jobId      String
  userId     String
  startedAt  DateTime
  endedAt    DateTime?
  minutes    Int?
  costRate   Decimal?  @db.Decimal(10, 2)
  note       String?
  autoClosed Boolean   @default(false)
  createdAt  DateTime  @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([userId, startedAt])
  @@map("time_entries")
}

model QualityCheck {
  id              String   @id @default(cuid())
  jobId           String
  checkedByUserId String
  passed          Boolean
  notes           String?
  createdAt       DateTime @default(now())

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  checkedBy User @relation(fields: [checkedByUserId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("quality_checks")
}

model JobFollowUp {
  id               String    @id @default(cuid())
  jobId            String
  dueAt            DateTime
  assignedToUserId String?
  note             String
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  job        Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assignedTo User? @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([dueAt, completedAt])
  @@map("job_follow_ups")
}

/// What a signature was given for. The record it belongs to says the rest. Phase 35.
enum SignaturePurpose {
  CHECK_IN
  CHECK_OUT
  ESTIMATE_APPROVAL
  TERMS
  WARRANTY
}

/// Somebody's mark on a pad, kept as the strokes that made it. A record of
/// its own, so the check-in, the check-out, an approval given across the
/// counter, the terms and a warranty all point at the same kind of thing.
/// Phase 35.
model Signature {
  id               String           @id @default(cuid())
  orgId            String
  purpose          SignaturePurpose
  signedByName     String
  /// Strokes as lists of [x, y] points in the pad's own pixels.
  strokes          Json
  width            Int
  height           Int
  jobId            String?
  customerId       String?
  capturedByUserId String?
  ip               String?
  userAgent        String?
  signedAt         DateTime         @default(now())

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job        Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  capturedBy User?             @relation("SignatureCapturedBy", fields: [capturedByUserId], references: [id], onDelete: SetNull)
  check      VehicleCheck?
  approval   EstimateApproval?

  @@index([orgId, signedAt])
  @@index([jobId])
  @@map("signatures")
}

enum CheckKind {
  IN
  OUT
}

/// The car as it was when it changed hands: arriving (IN) or leaving (OUT).
/// One of each per job at most. Phase 35.
model VehicleCheck {
  id                String    @id @default(cuid())
  orgId             String
  jobId             String
  kind              CheckKind
  odometerKm        Int?
  /// In eighths, from 0 (empty) to 8 (full).
  fuelEighths       Int?
  /// [{ area, note }] marks already on the car (IN) or noted at hand-back (OUT).
  damage            Json?
  belongings        String?
  /// What went back with the car at check-out: keys, papers, the old parts.
  documents         Json?
  notes             String?
  keysHook          String?
  /// Why the car left with money still owed, when it did.
  letGoOwingReason  String?
  signatureId       String?   @unique
  performedByUserId String?
  createdAt         DateTime  @default(now())

  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  signature   Signature?      @relation(fields: [signatureId], references: [id], onDelete: SetNull)
  performedBy User?           @relation("CheckPerformedBy", fields: [performedByUserId], references: [id], onDelete: SetNull)
  photos      JobAttachment[]

  @@unique([jobId, kind])
  @@index([orgId, createdAt])
  @@map("vehicle_checks")
}

enum KeyAction {
  HUNG
  TAKEN
  RETURNED
  HANDED_TO_CUSTOMER
}

/// Where the keys went, each time they moved. Where they are now is the
/// latest of these. Phase 35.
model KeyEvent {
  id       String    @id @default(cuid())
  orgId    String
  jobId    String
  action   KeyAction
  hook     String?
  byUserId String?
  at       DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  by  User?        @relation("KeyEventBy", fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([jobId, at])
  @@map("key_events")
}

// ===========================================================================
// INSPECTION
// ===========================================================================

model InspectionTemplate {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  org         Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sections    InspectionTemplateSection[]
  inspections Inspection[]

  @@unique([orgId, name])
  @@map("inspection_templates")
}

model InspectionTemplateSection {
  id         String @id @default(cuid())
  templateId String
  name       String
  sortOrder  Int    @default(0)

  template InspectionTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    InspectionTemplateItem[]

  @@index([templateId, sortOrder])
  @@map("inspection_template_sections")
}

model InspectionTemplateItem {
  id              String          @id @default(cuid())
  sectionId       String
  name            String
  guidance        String?
  measurementType MeasurementType @default(NONE)
  position        WheelPosition?
  sortOrder       Int             @default(0)

  section InspectionTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  results InspectionResult[]

  @@index([sectionId, sortOrder])
  @@map("inspection_template_items")
}

/// Structured measurements rather than prose, so wear is trackable. FR-709.
enum MeasurementType {
  NONE
  TREAD_DEPTH_MM
  PAD_THICKNESS_MM
  DISC_THICKNESS_MM
  PERCENT
  VOLTAGE
  PRESSURE_BAR
  TEMPERATURE_C
  MM
}

enum WheelPosition {
  FRONT_LEFT
  FRONT_RIGHT
  REAR_LEFT
  REAR_RIGHT
  SPARE
}

model Inspection {
  id                String           @id @default(cuid())
  jobId             String
  templateId        String?
  status            InspectionStatus @default(DRAFT)
  performedByUserId String?
  startedAt         DateTime         @default(now())
  completedAt       DateTime?
  notes             String?
  passCount         Int              @default(0)
  advisoryCount     Int              @default(0)
  criticalCount     Int              @default(0)

  job         Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  template    InspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  performedBy User?               @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)
  results     InspectionResult[]

  @@index([jobId])
  @@map("inspections")
}

enum InspectionStatus {
  DRAFT
  COMPLETED
}

model InspectionResult {
  id                String          @id @default(cuid())
  inspectionId      String
  templateItemId    String?
  sectionName       String
  itemName          String
  severity          Severity        @default(NOT_CHECKED)
  note              String?
  measurementValue  Decimal?        @db.Decimal(10, 2)
  measurementType   MeasurementType @default(NONE)
  position          WheelPosition?
  recommendedAction String?
  estimatedCost     Decimal?        @db.Decimal(12, 2)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())

  inspection    Inspection              @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  templateItem  InspectionTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  photos        InspectionPhoto[]
  estimateLines EstimateLine[]

  @@index([inspectionId, sortOrder])
  @@index([severity])
  @@map("inspection_results")
}

/// FR-702. Traffic-light severity, never conveyed by colour alone (NFR-603).
enum Severity {
  PASS
  ADVISORY
  CRITICAL
  NOT_CHECKED
}

model InspectionPhoto {
  id        String   @id @default(cuid())
  resultId  String
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  caption   String?
  createdAt DateTime @default(now())

  result InspectionResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@map("inspection_photos")
}

// ===========================================================================
// ESTIMATE AND APPROVAL
// ===========================================================================

model Estimate {
  id              String         @id @default(cuid())
  orgId           String
  jobId           String
  version         Int            @default(1)
  status          EstimateStatus @default(DRAFT)
  currency        String         @default("GBP")
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal        @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @default(0) @db.Decimal(12, 2)
  notes           String?
  validUntil      DateTime?
  sentAt          DateTime?
  decidedAt       DateTime?
  supersedesId    String?        @unique
  /// Extra work found mid-job, quoted without stopping the work already approved. Phase 34.
  supplementary   Boolean        @default(false)
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job          Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  supersedes   Estimate?          @relation("EstimateVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Estimate?          @relation("EstimateVersions")
  lines        EstimateLine[]
  shares       EstimateShare[]
  approvals    EstimateApproval[]

  @@unique([jobId, version])
  @@index([orgId, status])
  @@map("estimates")
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  PARTIALLY_APPROVED
  DECLINED
  EXPIRED
  SUPERSEDED
}

model EstimateLine {
  id                 String       @id @default(cuid())
  estimateId         String
  kind               LineKind     @default(LABOUR)
  description        String
  detail             String?
  quantity           Decimal      @default(1) @db.Decimal(10, 3)
  unitPrice          Decimal      @default(0) @db.Decimal(12, 2)
  unitCost           Decimal      @default(0) @db.Decimal(12, 4)
  discountPct        Decimal      @default(0) @db.Decimal(5, 2)
  taxRateId          String?
  lineTotal          Decimal      @default(0) @db.Decimal(12, 2)
  decision           LineDecision @default(PENDING)
  isOptional         Boolean      @default(false)
  sortOrder          Int          @default(0)
  inspectionResultId String?
  /// The stock item behind a part line, so approval can reserve it. Phase 34.
  productId          String?

  estimate         Estimate          @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  taxRate          TaxRate?          @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  inspectionResult InspectionResult? @relation(fields: [inspectionResultId], references: [id], onDelete: SetNull)
  product          Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([estimateId, sortOrder])
  @@index([productId])
  @@map("estimate_lines")
}

enum LineKind {
  LABOUR
  PART
  FEE
  DISCOUNT
}

/// FR-806. Customers may accept some lines and decline others.
enum LineDecision {
  PENDING
  APPROVED
  DECLINED
}

/// The secure link sent to the customer. Unguessable, expiring, revocable.
model EstimateShare {
  id         String         @id @default(cuid())
  estimateId String
  tokenHash  String         @unique
  channel    MessageChannel
  sentTo     String
  expiresAt  DateTime
  revokedAt  DateTime?
  openedAt   DateTime?
  openCount  Int            @default(0)
  createdAt  DateTime       @default(now())

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@map("estimate_shares")
}

/// The recorded customer decision. Immutable evidence. FR-807.
model EstimateApproval {
  id             String       @id @default(cuid())
  estimateId     String
  decision       LineDecision
  approvedTotal  Decimal      @db.Decimal(12, 2)
  declinedTotal  Decimal      @default(0) @db.Decimal(12, 2)
  approvedByName String?
  ip             String?
  userAgent      String?
  note           String?
  /// Signed on the pad, when the customer was in front of somebody. Phase 35.
  signatureId    String?      @unique
  createdAt      DateTime     @default(now())

  estimate  Estimate   @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  signature Signature? @relation(fields: [signatureId], references: [id], onDelete: SetNull)

  @@index([estimateId])
  @@map("estimate_approvals")
}

// ===========================================================================
// FINANCE
// ===========================================================================

model TaxRate {
  id        String  @id @default(cuid())
  orgId     String
  name      String
  rate      Decimal @db.Decimal(6, 3)
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  labourLines   JobLabourLine[]
  partLines     JobPartLine[]
  feeLines      JobFeeLine[]
  estimateLines EstimateLine[]
  invoiceLines  InvoiceLine[]
  saleLines     CounterSaleLine[]

  @@unique([orgId, name])
  @@map("tax_rates")
}

/// Gapless per-organisation document numbering. A database sequence would
/// leave gaps on rollback, which is not acceptable for tax documents. FR-902.
model DocumentSequence {
  id     String       @id @default(cuid())
  orgId  String
  kind   SequenceKind
  prefix String       @default("")
  next   Int          @default(1)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, kind])
  @@map("document_sequences")
}

enum SequenceKind {
  JOB
  ESTIMATE
  INVOICE
  CREDIT_NOTE
  PURCHASE_ORDER
  COUNTER_SALE
}

model Invoice {
  id            String        @id @default(cuid())
  orgId         String
  number        String
  jobId         String?
  customerId    String
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("GBP")
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  issuedAt      DateTime?
  dueAt         DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job              Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines            InvoiceLine[]
  payments         Payment[]
  giftCardEntries  GiftCardEntry[]
  depositMovements DepositMovement[]
  creditNotes      CreditNote[]
  refunds          Refund[]
  paymentAttempts  PaymentAttempt[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([customerId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  OVERDUE
  VOID
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  kind        LineKind @default(LABOUR)
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 3)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  unitCost    Decimal  @default(0) @db.Decimal(12, 4)
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  taxRateId   String?
  taxAmount   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)

  /// The job this line came from, when the invoice covers several. A
  /// consolidated fleet invoice has one job behind each line and none behind
  /// the invoice itself.
  jobId String?

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  job     Job?     @relation("InvoiceLineJob", fields: [jobId], references: [id], onDelete: SetNull)

  @@index([invoiceId, sortOrder])
  @@index([jobId])
  @@map("invoice_lines")
}

model Payment {
  id               String        @id @default(cuid())
  orgId            String
  invoiceId        String?
  customerId       String
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod @default(CARD)
  reference        String?
  receivedAt       DateTime      @default(now())
  notes            String?
  recordedByUserId String?
  createdAt        DateTime      @default(now())

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recordedBy       User?             @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  giftCardEntries  GiftCardEntry[]
  depositMovements DepositMovement[]
  attempt          PaymentAttempt?

  @@index([orgId, receivedAt])
  @@index([invoiceId])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  CHEQUE
  ACCOUNT
  OTHER
  /// Loyalty points redeemed against the bill. Posts to marketing, not to the bank.
  LOYALTY
  /// A gift card redeemed against the bill. Posts against the cards outstanding, not to the bank.
  GIFT_CARD
  /// Money already held for the customer, put against the bill. Posts against deposits, not to the bank.
  DEPOSIT
}

/// An issued invoice is immutable. Corrections are credit notes. FR-907.
model CreditNote {
  id        String   @id @default(cuid())
  orgId     String
  number    String
  invoiceId String
  amount    Decimal  @db.Decimal(12, 2)
  reason    String
  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([orgId, number])
  @@map("credit_notes")
}

/// Money going back to a customer. Phase 16.
///
/// A refund is its own record rather than a negative payment, because the
/// two answer different questions. A payment says what came in; a refund says
/// what went back, why, and against which credit note. Reporting that nets the
/// two together silently loses the second answer, and the second answer is the
/// one an argument at the counter turns on.
model Refund {
  id               String        @id @default(cuid())
  orgId            String
  invoiceId        String
  /// The credit note that justifies it. A refund with no credit note behind
  /// it is money leaving with no document saying why the customer was owed it.
  creditNoteId     String
  customerId       String
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod @default(BANK_TRANSFER)
  reference        String?
  reason           String
  refundedAt       DateTime      @default(now())
  recordedByUserId String?
  /// Sent back through the provider that took it: which attempt, and the provider's own reference. Phase 32.
  attemptId        String?
  providerRef      String?
  providerStatus   String?
  createdAt        DateTime      @default(now())

  org          Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  creditNote   CreditNote      @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recordedBy   User?           @relation("RefundRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  keptAsCredit Deposit[]
  attempt      PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([orgId, refundedAt])
  @@index([invoiceId])
  @@index([attemptId])
  @@map("refunds")
}

/// Money going to a supplier. Phase 16.
///
/// One payment can settle several bills, and one bill can be settled by
/// several payments, so the link between them is its own table with an
/// amount on it. A remittance advice is a list of those allocations, which is
/// why they are stored rather than derived.
model SupplierPayment {
  id               String        @id @default(cuid())
  orgId            String
  supplierId       String
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod @default(BANK_TRANSFER)
  reference        String?
  paidAt           DateTime      @default(now())
  note             String?
  recordedByUserId String?
  createdAt        DateTime      @default(now())

  org         Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier    Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  recordedBy  User?                       @relation("SupplierPaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  allocations SupplierPaymentAllocation[]

  @@index([orgId, paidAt])
  @@index([supplierId])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  billId    String
  amount    Decimal @db.Decimal(12, 2)

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    SupplierBill    @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([paymentId, billId])
  @@index([billId])
  @@map("supplier_payment_allocations")
}

enum PayrollRunStatus {
  DRAFT
  EXPORTED
  PAID
}

/// One pay period, exported once. Phase 16.
///
/// The product does not run payroll. It hands approved timesheets to whatever
/// does, as a file, and records that it did. The run exists so the same
/// timesheets cannot be handed over twice and so the wages posting has a
/// single document behind it.
model PayrollRun {
  id              String           @id @default(cuid())
  orgId           String
  periodStart     DateTime
  periodEnd       DateTime
  status          PayrollRunStatus @default(DRAFT)
  employeeCount   Int              @default(0)
  gross           Decimal          @default(0) @db.Decimal(12, 2)
  exportedAt      DateTime?
  paidAt          DateTime?
  createdByUserId String?
  createdAt       DateTime         @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy  User?        @relation("PayrollRunCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  timesheets Timesheet[]

  @@unique([orgId, periodStart, periodEnd])
  @@index([orgId, status])
  @@map("payroll_runs")
}

/// What a fleet customer has agreed. Phase 16.
///
/// One row per company customer, and only for those who have negotiated
/// terms. Its absence means list price, which is how every other customer is
/// treated and how a fleet without an agreement should be too.
model FleetAgreement {
  id                    String   @id @default(cuid())
  orgId                 String
  customerId            String   @unique
  labourDiscountPct     Decimal  @default(0) @db.Decimal(5, 2)
  partsDiscountPct      Decimal  @default(0) @db.Decimal(5, 2)
  paymentTermsDays      Int      @default(30)
  /// One invoice a month for everything completed, rather than one per job.
  consolidateMonthly    Boolean  @default(true)
  /// Whether their purchase order number has to be on every job.
  purchaseOrderRequired Boolean  @default(false)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("fleet_agreements")
}

/// A key that lets something the workshop already runs read its records. Phase 18.
///
/// The token is shown once and only its digest is stored, the same treatment
/// as a session or a share link. A key belongs to one organisation and can
/// read only that organisation's records plus the vehicle histories it is
/// entitled to, exactly as a signed-in owner could.
/// The vehicle's paperwork. Phase 20.
///
/// Documents belong to the car, not to the workshop that scanned them, so a
/// workshop with read access to the vehicle sees them and so does the owner.
/// Nothing is deleted: a removed document keeps its row and its reason.
model VehicleDocument {
  id               String              @id @default(cuid())
  vehicleId        String
  kind             VehicleDocumentKind
  title            String
  /// Policy number, certificate number, receipt number.
  reference        String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  fileKey          String
  filename         String
  mimeType         String
  sizeBytes        Int
  note             String?
  /// The workshop that added it, or null when the owner did from the portal.
  uploadedByOrgId  String?
  uploadedByUserId String?
  removedAt        DateTime?
  removedReason    String?
  createdAt        DateTime            @default(now())

  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  uploadedByOrg Organization? @relation(fields: [uploadedByOrgId], references: [id], onDelete: SetNull)
  uploadedBy    User?         @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([vehicleId, kind])
  @@index([vehicleId, expiresAt])
  @@map("vehicle_documents")
}

enum VehicleDocumentKind {
  PHOTO
  REGISTRATION_CERTIFICATE
  MOT_CERTIFICATE
  INSURANCE
  SERVICE_RECORD
  PURCHASE_INVOICE
  OTHER
}

/// One exchange with the assistant. Phase 22.
///
/// The prompt, the reply, whether a model touched it and what it cost, so an
/// owner can see what the assistant is doing and what it is spending. The
/// reply is what the person saw; a model's rejected output is not kept.
model AssistantExchange {
  id            String        @id @default(cuid())
  orgId         String
  userId        String?
  kind          AssistantKind
  prompt        String
  reply         String
  /// Null when no model was involved.
  model         String?
  inputTokens   Int           @default(0)
  outputTokens  Int           @default(0)
  polished      Boolean       @default(false)
  rejected      String?
  relatedType   String?
  relatedId     String?
  /// Set when a drafted message was sent, so a draft cannot be sent twice.
  sentMessageId String?
  createdAt     DateTime      @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@map("assistant_exchanges")
}

enum AssistantKind {
  QUESTION
  DRAFT
  EXPLAIN
}

model ApiKey {
  id              String    @id @default(cuid())
  orgId           String
  name            String
  /// The first characters of the token, so a key can be recognised in a list
  /// without the token being recoverable.
  prefix          String
  keyHash         String    @unique
  createdByUserId String?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  /// Fixed-window rate limit: calls in the window that began at windowStartedAt. FR-4803.
  windowStartedAt DateTime?
  windowCount     Int       @default(0)
  createdAt       DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("ApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, revokedAt])
  @@map("api_keys")
}

// ===========================================================================
// COMMUNICATION AND SCHEDULING
// ===========================================================================

model MessageLog {
  id String @id @default(cuid())

  /// Null for a message the platform sends on nobody's behalf: a password
  /// reset for a customer who has not yet been attached to any workshop. A
  /// workshop's own message list filters on this, so a platform message
  /// correctly appears in none of them.
  orgId       String?
  channel     MessageChannel
  toAddress   String
  subject     String?
  body        String
  status      MessageStatus  @default(QUEUED)
  provider    String?
  providerRef String?
  error       String?
  /// How many times sending has been attempted. A message is given up on
  /// rather than retried forever: past the limit somebody has to look.
  attempts    Int            @default(0)
  /// Not before this. Carries both the retry backoff and the quiet-hours
  /// hold, because from the sender's side they are the same instruction.
  availableAt DateTime       @default(now())
  relatedType String?
  relatedId   String?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  /// The thread this belongs to, once filed. Phase 36.
  conversationId String?
  /// A person who wrote it, when a person did; null for the product's own messages.
  sentByUserId   String?

  org            Organization?       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation   Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sentBy         User?               @relation("MessageSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  deliveryEvents DeliveryEvent[]
  attachments    MessageAttachment[]

  @@index([orgId, createdAt])
  @@index([relatedType, relatedId])
  /// The sweeper's query: what is due, oldest first.
  @@index([status, availableAt])
  @@index([conversationId])
  @@map("message_logs")
}

enum MessageChannel {
  EMAIL
  SMS
  PORTAL
  WHATSAPP
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SUPPRESSED
}

/// Next service due, by date and by projected mileage. FR-1504.
model ServiceSchedule {
  id              String    @id @default(cuid())
  orgId           String?
  vehicleId       String
  name            String
  intervalMonths  Int?
  intervalKm      Int?
  lastPerformedAt DateTime?
  lastPerformedKm Int?
  dueAt           DateTime?
  dueKm           Int?
  reminderSentAt  DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vehicle Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([dueAt, isActive])
  @@map("service_schedules")
}

// ===========================================================================
// INVENTORY  —  Phase 2. Schema present now so migrations stay additive.
// ===========================================================================

model ProductCategory {
  id       String  @id @default(cuid())
  orgId    String
  name     String
  parentId String?

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([orgId, name])
  @@map("product_categories")
}

model Product {
  id           String   @id @default(cuid())
  orgId        String
  categoryId   String?
  partNumber   String
  name         String
  description  String?
  brand        String?
  unit         String   @default("each")
  costPrice    Decimal  @default(0) @db.Decimal(12, 4)
  sellPrice    Decimal  @default(0) @db.Decimal(12, 2)
  reorderPoint Decimal  @default(0) @db.Decimal(12, 3)
  reorderQty   Decimal  @default(0) @db.Decimal(12, 3)
  barcode      String?
  isStocked    Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category      ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockLevels   StockLevel[]
  movements     StockMovement[]
  reservations  StockReservation[]
  jobPartLines  JobPartLine[]
  estimateLines EstimateLine[]
  packageLines  ServicePackageLine[]
  poLines       PurchaseOrderLine[]
  transferLines StockTransferLine[]
  saleLines     CounterSaleLine[]
  warranties    Warranty[]
  fitments      PartFitment[]

  @@unique([orgId, partNumber])
  @@index([orgId, isActive])
  @@map("products")
}

model Warehouse {
  id         String  @id @default(cuid())
  orgId      String
  locationId String?
  name       String
  code       String
  isDefault  Boolean @default(false)

  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location     Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  stockLevels  StockLevel[]
  movements    StockMovement[]
  reservations StockReservation[]
  transfersOut StockTransfer[]    @relation("TransferOrigin")
  transfersIn  StockTransfer[]    @relation("TransferDestination")

  @@unique([orgId, code])
  @@map("warehouses")
}

model StockLevel {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  onHand      Decimal  @default(0) @db.Decimal(12, 3)
  reserved    Decimal  @default(0) @db.Decimal(12, 3)
  /// Weighted average cost. FR-1005.
  avgCost     Decimal  @default(0) @db.Decimal(12, 4)
  binLocation String?
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id            String       @id @default(cuid())
  orgId         String
  productId     String
  warehouseId   String
  type          MovementType
  quantity      Decimal      @db.Decimal(12, 3)
  unitCost      Decimal      @default(0) @db.Decimal(12, 4)
  balanceAfter  Decimal      @default(0) @db.Decimal(12, 3)
  referenceType String?
  referenceId   String?
  reason        String?
  createdAt     DateTime     @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([orgId, createdAt])
  @@map("stock_movements")
}

enum MovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  STOCKTAKE
}

model StockReservation {
  id            String    @id @default(cuid())
  productId     String
  warehouseId   String
  jobPartLineId String?
  quantity      Decimal   @db.Decimal(12, 3)
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  jobPartLine JobPartLine? @relation(fields: [jobPartLineId], references: [id], onDelete: Cascade)

  @@index([productId, releasedAt])
  @@map("stock_reservations")
}

model Supplier {
  id               String   @id @default(cuid())
  orgId            String
  name             String
  accountRef       String?
  email            String?
  phone            String?
  addressLine1     String?
  locality         String?
  postcode         String?
  paymentTermsDays Int      @default(30)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  org            Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]
  payments       SupplierPayment[]
  warranties     Warranty[]

  @@unique([orgId, name])
  @@map("suppliers")
}

model PurchaseRequest {
  id                String                @id @default(cuid())
  orgId             String
  jobId             String?
  requestedByUserId String?
  status            PurchaseRequestStatus @default(PENDING)
  notes             String?
  approvedByUserId  String?
  approvedAt        DateTime?
  createdAt         DateTime              @default(now())

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job        Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  approvedBy User?           @relation("PurchaseApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  orders     PurchaseOrder[]

  @@index([orgId, status])
  @@map("purchase_requests")
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  ORDERED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  orgId      String
  number     String
  supplierId String
  requestId  String?
  status     PurchaseOrderStatus @default(DRAFT)
  expectedAt DateTime?
  subtotal   Decimal             @default(0) @db.Decimal(12, 2)
  taxTotal   Decimal             @default(0) @db.Decimal(12, 2)
  total      Decimal             @default(0) @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  org      Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  request  PurchaseRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]
  bills    SupplierBill[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@map("purchase_orders")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PART_RECEIVED
  RECEIVED
  BILLED
  CANCELLED
}

model PurchaseOrderLine {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  description String
  quantity    Decimal @db.Decimal(12, 3)
  received    Decimal @default(0) @db.Decimal(12, 3)
  unitCost    Decimal @default(0) @db.Decimal(12, 4)
  sortOrder   Int     @default(0)

  order        PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  receiptLines GoodsReceiptLine[]

  @@index([orderId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id         String   @id @default(cuid())
  orderId    String
  receivedAt DateTime @default(now())
  reference  String?
  notes      String?

  order PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines GoodsReceiptLine[]

  @@index([orderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id          String  @id @default(cuid())
  receiptId   String
  orderLineId String
  quantity    Decimal @db.Decimal(12, 3)
  unitCost    Decimal @default(0) @db.Decimal(12, 4)

  receipt   GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLine PurchaseOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("goods_receipt_lines")
}

model SupplierBill {
  id         String     @id @default(cuid())
  orgId      String
  supplierId String
  orderId    String?
  reference  String
  status     BillStatus @default(AWAITING)
  subtotal   Decimal    @default(0) @db.Decimal(12, 2)
  taxTotal   Decimal    @default(0) @db.Decimal(12, 2)
  total      Decimal    @default(0) @db.Decimal(12, 2)
  amountPaid Decimal    @default(0) @db.Decimal(12, 2)
  billedAt   DateTime
  dueAt      DateTime?
  createdAt  DateTime   @default(now())

  org         Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier    Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  order       PurchaseOrder?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  allocations SupplierPaymentAllocation[]

  @@unique([orgId, reference])
  @@index([orgId, status])
  @@map("supplier_bills")
}

enum BillStatus {
  AWAITING
  APPROVED
  PART_PAID
  PAID
  DISPUTED
}

// ===========================================================================
// ACCOUNTING  —  Phase 3. Schema present now so migrations stay additive.
// ===========================================================================

model Account {
  id       String      @id @default(cuid())
  orgId    String
  code     String
  name     String
  type     AccountType
  parentId String?
  isActive Boolean     @default(true)

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Account?      @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Account[]     @relation("AccountTree")
  lines    JournalLine[]

  @@unique([orgId, code])
  @@index([orgId, type])
  @@map("accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model FiscalPeriod {
  id       String    @id @default(cuid())
  orgId    String
  name     String
  startsAt DateTime
  endsAt   DateTime
  isClosed Boolean   @default(false)
  closedAt DateTime?

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entries JournalEntry[]

  @@unique([orgId, name])
  @@index([orgId, startsAt])
  @@map("fiscal_periods")
}

/// Every entry must balance. An unbalanced entry is rejected. FR-1202.
model JournalEntry {
  id          String   @id @default(cuid())
  orgId       String
  periodId    String?
  reference   String
  description String
  postedAt    DateTime @default(now())
  /// The operational document that caused this posting. FR-1205.
  sourceType  String?
  sourceId    String?
  isReversal  Boolean  @default(false)
  reversesId  String?  @unique
  createdAt   DateTime @default(now())

  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period     FiscalPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  reverses   JournalEntry? @relation("EntryReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy JournalEntry? @relation("EntryReversal")
  lines      JournalLine[]

  @@index([orgId, postedAt])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  memo      String?
  sortOrder Int     @default(0)

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

/**
 * ===========================================================================
 * PEOPLE — Phase 4
 * The workshop side of a person, separate from the login account. A user is
 * how somebody signs in; an employee is what they cost, when they are here,
 * and what they are qualified to sign off. Those have different lifetimes: an
 * employment record must survive long after an account is disabled, because
 * last year's job costs are built on it.
 * ===========================================================================
 */

enum EmploymentType {
  EMPLOYEE
  CONTRACTOR
  APPRENTICE
}

model Employee {
  id                     String         @id @default(cuid())
  orgId                  String
  userId                 String?        @unique
  locationId             String?
  reference              String
  displayName            String
  jobTitle               String?
  employment             EmploymentType @default(EMPLOYEE)
  startedOn              DateTime
  endedOn                DateTime?
  /// Contracted minutes per week, used as the overtime threshold.
  weeklyMinutes          Int            @default(2400)
  holidayEntitlementDays Decimal        @default(28) @db.Decimal(5, 1)
  emergencyContactName   String?
  emergencyContactPhone  String?
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  org              Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  location         Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  payRates         PayRate[]
  attendance       AttendanceRecord[]
  timesheets       Timesheet[]
  absences         Absence[]
  certifications   Certification[]
  commissionAwards CommissionAward[]
  expenseClaims    Expense[]          @relation("ExpenseClaimant")
  skills           EmployeeSkill[]
  workingPatterns  WorkingPattern[]

  @@unique([orgId, reference])
  @@index([orgId, isActive])
  @@map("employees")
}

/// Effective-dated. A rate is never edited, only closed and superseded, so
/// asking what an hour cost means asking what it cost on that day. ADR-0013.
model PayRate {
  id            String    @id @default(cuid())
  orgId         String
  employeeId    String
  costPerHour   Decimal   @db.Decimal(10, 2)
  chargePerHour Decimal   @db.Decimal(10, 2)
  effectiveFrom DateTime
  /// Null while this is the rate in force.
  effectiveTo   DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@map("pay_rates")
}

/// On site and being paid. Distinct from TimeEntry, which is time on a job.
/// The gap between the two is what utilisation measures.
model AttendanceRecord {
  id           String    @id @default(cuid())
  orgId        String
  employeeId   String
  locationId   String?
  startedAt    DateTime
  endedAt      DateTime?
  breakMinutes Int       @default(0)
  /// Set when a shift was closed by the worker rather than by the person.
  autoClosed   Boolean   @default(false)
  note         String?
  createdAt    DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([employeeId, startedAt])
  @@index([orgId, startedAt])
  @@map("attendance_records")
}

enum TimesheetStatus {
  OPEN
  SUBMITTED
  APPROVED
  PAID
}

/// A pay period for one person. Approved once, then it stops moving: payroll
/// is the one place where "somebody edited it afterwards" is unrecoverable.
model Timesheet {
  id               String          @id @default(cuid())
  orgId            String
  employeeId       String
  periodStart      DateTime
  periodEnd        DateTime
  status           TimesheetStatus @default(OPEN)
  ordinaryMinutes  Int             @default(0)
  overtimeMinutes  Int             @default(0)
  absenceMinutes   Int             @default(0)
  ordinaryPay      Decimal         @default(0) @db.Decimal(12, 2)
  overtimePay      Decimal         @default(0) @db.Decimal(12, 2)
  gross            Decimal         @default(0) @db.Decimal(12, 2)
  submittedAt      DateTime?
  approvedAt       DateTime?
  approvedByUserId String?
  paidAt           DateTime?
  note             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("TimesheetApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  /// The run that handed this sheet to payroll. Set once, when it is exported.
  payrollRunId String?
  payrollRun   PayrollRun?  @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@unique([employeeId, periodStart])
  @@index([orgId, status])
  @@map("timesheets")
}

enum AbsenceType {
  HOLIDAY
  SICK
  UNPAID
  TRAINING
  OTHER
}

model Absence {
  id         String      @id @default(cuid())
  orgId      String
  employeeId String
  type       AbsenceType
  startsOn   DateTime
  endsOn     DateTime
  /// Working days, so a weekend inside a week off does not consume holiday.
  days       Decimal     @db.Decimal(5, 1)
  approved   Boolean     @default(false)
  note       String?
  createdAt  DateTime    @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startsOn])
  @@map("absences")
}

/// Qualifications with an expiry. An MOT tester whose licence lapsed is a
/// legal problem, not a reminder, so this is queried rather than filed.
model Certification {
  id         String    @id @default(cuid())
  orgId      String
  employeeId String
  name       String
  authority  String?
  reference  String?
  issuedOn   DateTime?
  expiresOn  DateTime?
  createdAt  DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([orgId, expiresOn])
  @@map("certifications")
}

/// What a technician can do, and how well. Phase 12.
///
/// A workshop with "technician" as the only distinction produces a rota
/// somebody has to redo by hand every morning, because the rota does not know
/// that only one of them is an MOT tester.
enum SkillLevel {
  LEARNING
  COMPETENT
  EXPERT
}

/// A kind of work somebody can be signed off on. Named by the workshop, not
/// by us: a truck garage and a tyre bay do not share a vocabulary.
model Skill {
  id        String  @id @default(cuid())
  orgId     String
  name      String
  /// Shown under the name on the matrix, so "EV" can say what it covers.
  note      String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employees EmployeeSkill[]
  jobTypes  JobTypeSkill[]

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("skills")
}

/// One person signed off on one skill.
///
/// The absence of a row means they cannot do it. That is deliberate: a
/// NONE level would be a row asserting an absence, and the two would
/// eventually disagree.
model EmployeeSkill {
  id               String     @id @default(cuid())
  employeeId       String
  skillId          String
  level            SkillLevel @default(COMPETENT)
  /// When somebody last said this was true, which is what makes it evidence
  /// rather than an opinion typed in 2019.
  assessedOn       DateTime   @default(now())
  assessedByUserId String?
  note             String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  assessedBy User?    @relation(fields: [assessedByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeId, skillId])
  @@index([skillId, level])
  @@map("employee_skills")
}

/// What a kind of work needs before somebody may be given it.
model JobTypeSkill {
  id           String     @id @default(cuid())
  jobTypeId    String
  skillId      String
  minimumLevel SkillLevel @default(COMPETENT)
  createdAt    DateTime   @default(now())

  jobType JobType @relation(fields: [jobTypeId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobTypeId, skillId])
  @@map("job_type_skills")
}

/// When somebody is contracted to be here.
///
/// Replaces the single `dailyCapacityHours` figure on a site, which was a
/// number typed once and knew nothing about holidays, part-time hours or the
/// apprentice at college on Fridays. One row per person per weekday they
/// work; a weekday with no row is a day they are not in.
model WorkingPattern {
  id           String @id @default(cuid())
  orgId        String
  employeeId   String
  /// ISO weekday: 1 is Monday, 7 is Sunday.
  weekday      Int
  /// Minutes from midnight, local to the site.
  startMinute  Int
  endMinute    Int
  breakMinutes Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, weekday])
  @@index([orgId, weekday])
  @@map("working_patterns")
}

/// Where a fitment claim came from, which changes how much it is worth.
enum FitmentSource {
  /// The manufacturer's own catalogue.
  MANUFACTURER
  /// A supplier's catalogue.
  SUPPLIER
  /// Somebody here typed it in.
  WORKSHOP
  /// Inferred from this workshop having fitted one before.
  OBSERVED
}

/// Which vehicles a part fits.
///
/// Deliberately not inferred from anything. Guessing which pads fit a
/// particular car puts the wrong pads on it, and the person who finds out is
/// braking. Until a fitment provider is wired in these rows come from a
/// person, and the absence of a row means nobody has said rather than that
/// the part does not fit.
model PartFitment {
  id         String        @id @default(cuid())
  orgId      String
  productId  String
  make       String
  model      String?
  /// Inclusive. Null at either end is open in that direction.
  yearFrom   Int?
  yearTo     Int?
  /// Narrows further where one model spans two engines.
  engineCode String?
  source     FitmentSource @default(WORKSHOP)
  note       String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([orgId, make, model])
  @@map("part_fitments")
}

/// One action a device recorded offline and the server has since applied.
///
/// Exists for one reason: a flush interrupted halfway must not write
/// everything again when the signal comes back. The device generates the id
/// before it sends anything, and this table is the record of which ids have
/// already been honoured.
///
/// Only applied actions are kept. A conflict stays on the device with the
/// reason it was refused, because the person holding the device is the one who
/// has to decide what to do about it, and a row here would make the retry read
/// as a duplicate and disappear.
model SyncedAction {
  id String @id @default(cuid())

  orgId  String
  userId String?

  /// Generated on the device. Unique within a workshop.
  clientId  String
  type      String
  /// The job, inspection or vehicle it happened to.
  subjectId String

  /// When it happened on the device, which is not when it arrived.
  recordedAt DateTime
  appliedAt  DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([orgId, clientId])
  @@index([orgId, appliedAt])
  @@index([subjectId])
  @@map("synced_actions")
}

/// Where a rating was routed. The whole point of asking.
enum ReviewRouting {
  PENDING
  PUBLIC_INVITE
  THANKS_ONLY
  PRIVATE_CONVERSATION
}

/// One customer asked how a job went.
///
/// One per job, enforced by a unique index. Asking twice about the same repair
/// is how a workshop teaches somebody to ignore it.
model ReviewRequest {
  id         String @id @default(cuid())
  orgId      String
  jobId      String @unique
  customerId String

  /// Only the digest is stored, as with every capability in this product.
  tokenHash String   @unique
  channel   String   @default("EMAIL")
  sentAt    DateTime @default(now())
  expiresAt DateTime

  /// Null until they answer. One to five.
  rating      Int?
  comment     String?
  respondedAt DateTime?

  routing ReviewRouting @default(PENDING)

  /// Set when somebody followed the public invitation.
  publicOpenedAt DateTime?

  /// A poor rating is a conversation, and this is how it closes.
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolutionNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  resolvedBy User?        @relation(fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, sentAt])
  @@index([orgId, routing])
  @@index([customerId, sentAt])
  @@map("review_requests")
}

/// One movement of points, positive or negative.
///
/// The balance is the sum of these rather than a figure somebody edits, so it
/// can never drift from the history that produced it.
model LoyaltyEntry {
  id         String @id @default(cuid())
  orgId      String
  customerId String

  /// Whole points. Positive awards, negative spends.
  points Int
  reason String

  jobId     String?
  /// Awards lapse; spends never do.
  expiresAt DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer  Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job       Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, customerId, createdAt])
  @@index([expiresAt])
  @@map("loyalty_entries")
}

/// A code one customer gives another.
model Referral {
  id                 String @id @default(cuid())
  orgId              String
  referrerCustomerId String

  /// Said out loud over a counter, so no character that gets misheard.
  code String

  referredCustomerId String?
  referredJobId      String?
  usedAt             DateTime?

  /// Set once, when both sides have been paid.
  creditedAt DateTime?
  points     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  referrer Customer     @relation("ReferralsMade", fields: [referrerCustomerId], references: [id], onDelete: Cascade)
  referred Customer?    @relation("ReferralsUsed", fields: [referredCustomerId], references: [id], onDelete: SetNull)
  job      Job?         @relation(fields: [referredJobId], references: [id], onDelete: SetNull)

  @@unique([orgId, code])
  @@index([orgId, creditedAt])
  @@map("referrals")
}

/// Something a customer sent in.
///
/// Matched to a customer and a job with a stated confidence rather than a
/// silent assignment: a reply filed against the wrong job is worse than one
/// filed against nothing, because somebody reads it about another car.
model InboundMessage {
  id      String @id @default(cuid())
  orgId   String
  channel String @default("SMS")

  fromAddress String
  subject     String?
  body        String
  receivedAt  DateTime @default(now())

  /// The provider's own id, so the same message delivered twice is recognised.
  providerRef String?

  customerId String?
  jobId      String?
  /// CERTAIN, PROBABLE, POSSIBLE or NONE.
  confidence String  @default("NONE")
  matchNote  String?

  handledAt       DateTime?
  handledByUserId String?

  /// The thread it was filed onto. Phase 36.
  conversationId String?

  createdAt DateTime @default(now())

  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer     Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job          Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  handledBy    User?               @relation(fields: [handledByUserId], references: [id], onDelete: SetNull)
  conversation Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]

  @@unique([orgId, providerRef])
  @@index([orgId, receivedAt])
  @@index([conversationId])
  @@index([orgId, handledAt])
  @@index([jobId])
  @@map("inbound_messages")
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// A one-time link sent to an address.
///
/// Email verification and password reset are the same mechanism with
/// different windows, so they are one table. Only the digest is stored: a
/// link that leaks cannot be read back out of the database, which is the same
/// rule every other capability in this product follows.
model AuthToken {
  id      String       @id @default(cuid())
  userId  String
  purpose TokenPurpose

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  /// Where it was asked for, so a flood has a shape somebody can look at.
  requestedIp String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_tokens")
}

enum SuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  MANUAL
}

/// An address nothing may be sent to.
///
/// A mailbox that does not exist today will not exist tomorrow, and carrying on
/// sending to it is how a sender's reputation is destroyed: providers read a
/// high bounce rate as evidence the list was bought rather than earned, and
/// start filing everything else as spam.
///
/// Lifted by a person, never automatically. An address that starts working
/// again is usually an address somebody corrected, and correcting it is the
/// moment to say so.
model SuppressedAddress {
  id      String            @id @default(cuid())
  orgId   String
  address String
  reason  SuppressionReason
  /// What the provider actually said, kept for whoever has to explain it.
  detail  String?

  liftedAt       DateTime?
  liftedByUserId String?
  liftedNote     String?

  createdAt DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  liftedBy User?        @relation(fields: [liftedByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@map("suppressed_addresses")
}

/// One thing a provider said about a message after it left.
///
/// Kept as its own rows rather than folded into the message, because a single
/// message produces several and they arrive out of order. The message carries
/// the conclusion; this carries the account of how it got there.
model DeliveryEvent {
  id           String  @id @default(cuid())
  orgId        String
  messageLogId String?

  event       String
  detail      String?
  /// The provider's own id for the event, so a retried webhook is one row.
  providerRef String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messageLog MessageLog?  @relation(fields: [messageLogId], references: [id], onDelete: SetNull)

  @@unique([orgId, providerRef])
  @@index([messageLogId, occurredAt])
  @@index([orgId, event, occurredAt])
  @@map("delivery_events")
}

enum ConversationStatus {
  OPEN
  CLOSED
}

/// One thread per customer, and one per job when a message is about a job,
/// whatever carried it. What went out and what came back are filed onto it.
/// Phase 36.
model Conversation {
  id               String             @id @default(cuid())
  orgId            String
  customerId       String?
  jobId            String?            @unique
  subject          String?
  status           ConversationStatus @default(OPEN)
  assignedToUserId String?
  /// The channel the last message travelled by, so a reply goes back the same way.
  lastChannel      String?
  lastMessageAt    DateTime           @default(now())
  lastInboundAt    DateTime?
  /// When somebody at the workshop last looked. Unread is an inbound after this.
  readAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job         Job?                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assignedTo  User?               @relation("ConversationAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  outbound    MessageLog[]
  inbound     InboundMessage[]
  attachments MessageAttachment[]

  @@index([orgId, lastMessageAt])
  @@index([customerId])
  @@index([assignedToUserId])
  @@map("conversations")
}

/// A file that travelled with a message, in either direction. Phase 36.
model MessageAttachment {
  id               String   @id @default(cuid())
  orgId            String
  conversationId   String
  messageLogId     String?
  inboundMessageId String?
  url              String
  filename         String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())

  org          Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageLog   MessageLog?     @relation(fields: [messageLogId], references: [id], onDelete: SetNull)
  inbound      InboundMessage? @relation(fields: [inboundMessageId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([messageLogId])
  @@index([inboundMessageId])
  @@map("message_attachments")
}

/// A workshop's own sentences, filled from the job when sent. Phase 36.
model MessageTemplate {
  id              String          @id @default(cuid())
  orgId           String
  name            String
  /// Null: any channel.
  channel         MessageChannel?
  subject         String?
  body            String
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, name])
  @@map("message_templates")
}

enum VehicleClaimStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// A customer asking for a vehicle to be put on their account.
///
/// A VIN is visible through a windscreen and a plate from further away, so
/// neither is evidence of anything. Every claim is answered by a person at the
/// workshop that serviced the vehicle, and the product never decides one on its
/// own: it has no way to tell an owner from somebody who walked past the car.
model VehicleClaim {
  id        String @id @default(cuid())
  userId    String
  vehicleId String
  /// The workshop being asked. The one that last worked on it.
  orgId     String

  status VehicleClaimStatus @default(PENDING)
  /// Anything the customer offered to help identify themselves.
  note   String?

  askedAt DateTime @default(now())

  decidedAt       DateTime?
  decidedByUserId String?
  /// Required on a refusal. A no with nothing behind it produces a phone call.
  reason          String?

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  decidedBy User?        @relation("ClaimDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, status, askedAt])
  @@index([userId, askedAt])
  @@index([vehicleId])
  @@map("vehicle_claims")
}

enum CommissionBasis {
  LABOUR_REVENUE
  LABOUR_PROFIT
  PARTS_PROFIT
  JOB_PROFIT
  PER_JOB
}

model CommissionScheme {
  id               String          @id @default(cuid())
  orgId            String
  name             String
  basis            CommissionBasis
  /// Nothing is paid until the basis clears this.
  threshold        Decimal         @default(0) @db.Decimal(12, 2)
  /// Paid even when the calculation comes out lower.
  guarantee        Decimal         @default(0) @db.Decimal(12, 2)
  /// Withhold until the customer has actually paid.
  paidOnSettlement Boolean         @default(true)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())

  org    Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bands  CommissionBand[]
  awards CommissionAward[]

  @@unique([orgId, name])
  @@map("commission_schemes")
}

/// Marginal bands. The rate applies to the part of the basis above `from`,
/// never to the whole of it: a cliff edge distorts behaviour at month end.
model CommissionBand {
  id         String  @id @default(cuid())
  schemeId   String
  fromAmount Decimal @default(0) @db.Decimal(12, 2)
  rate       Decimal @db.Decimal(6, 3)
  sortOrder  Int     @default(0)

  scheme CommissionScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([schemeId, sortOrder])
  @@map("commission_bands")
}

model CommissionAward {
  id               String   @id @default(cuid())
  orgId            String
  employeeId       String
  schemeId         String
  periodStart      DateTime
  periodEnd        DateTime
  basisTotal       Decimal  @default(0) @db.Decimal(12, 2)
  earned           Decimal  @default(0) @db.Decimal(12, 2)
  jobCount         Int      @default(0)
  withheldCount    Int      @default(0)
  guaranteeApplied Boolean  @default(false)
  note             String?
  createdAt        DateTime @default(now())

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  scheme   CommissionScheme @relation(fields: [schemeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, schemeId, periodStart])
  @@index([orgId, periodStart])
  @@map("commission_awards")
}

/**
 * ===========================================================================
 * MULTI-SITE — Phase 4
 * Stock moving between warehouses in the same organisation. Three quantities,
 * not two: sent, received, and the difference sitting in a van. Without the
 * third, stock that has left one site and not reached the other disappears
 * from every report and reads as shrinkage at the next stocktake.
 * ===========================================================================
 */

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  PART_RECEIVED
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id                 String         @id @default(cuid())
  orgId              String
  reference          String
  fromWarehouseId    String
  toWarehouseId      String
  status             TransferStatus @default(DRAFT)
  dispatchedAt       DateTime?
  receivedAt         DateTime?
  dispatchedByUserId String?
  receivedByUserId   String?
  note               String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse           @relation("TransferOrigin", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse           @relation("TransferDestination", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  dispatchedBy  User?               @relation("TransferDispatcher", fields: [dispatchedByUserId], references: [id], onDelete: SetNull)
  receivedBy    User?               @relation("TransferReceiver", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  lines         StockTransferLine[]

  @@unique([orgId, reference])
  @@index([orgId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id         String  @id @default(cuid())
  transferId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  received   Decimal @default(0) @db.Decimal(12, 3)
  /// Weighted average cost at the origin on dispatch. Travels with the stock,
  /// so a transfer never changes what the group's inventory is worth.
  unitCost   Decimal @default(0) @db.Decimal(12, 4)
  sortOrder  Int     @default(0)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_lines")
}

/**
 * ===========================================================================
 * TEAM — Phase 4.6
 * Until this existed, the only way to add a second user was a database write,
 * which means in practice a workshop could not add its second user.
 * An invitation is a capability, so only the digest of its token is stored,
 * the same treatment as a session and a passport share link. A database
 * disclosure must not hand somebody a way into a workshop.
 * ===========================================================================
 */

model Invitation {
  id              String    @id @default(cuid())
  orgId           String
  email           String
  role            Role
  locationId      String?
  /// SHA-256 of the token in the link. The token itself is never stored.
  tokenHash       String    @unique
  invitedByUserId String?
  message         String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User?        @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, acceptedAt])
  @@index([email])
  @@map("invitations")
}

/**
 * ===========================================================================
 * COUNTER SALES — Phase 4.7
 * A sale with no job behind it. Somebody wants a bulb, pays, and leaves.
 * The three things a job normally anchors have to work without it: the ledger
 * posting, the stock movement and the cost. Cash and card are recorded
 * separately because they arrive on different days, and a bank reconciliation
 * that cannot tell them apart is not a reconciliation.
 * ===========================================================================
 */

enum CounterSaleStatus {
  OPEN
  PAID
  REFUNDED
  VOID
}

enum TenderKind {
  CASH
  CARD
  ACCOUNT
  GIFT_CARD
}

model CounterSale {
  id            String            @id @default(cuid())
  orgId         String
  locationId    String?
  /// Optional. Most counter sales are to somebody who never gives a name.
  customerId    String?
  reference     String
  status        CounterSaleStatus @default(OPEN)
  soldByUserId  String?
  tillSessionId String?
  subtotal      Decimal           @default(0) @db.Decimal(12, 2)
  discountTotal Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal           @default(0) @db.Decimal(12, 2)
  total         Decimal           @default(0) @db.Decimal(12, 2)
  /// Weighted average cost of everything on the sale, at the moment of sale.
  costTotal     Decimal           @default(0) @db.Decimal(12, 2)
  changeGiven   Decimal           @default(0) @db.Decimal(12, 2)
  refundedTotal Decimal           @default(0) @db.Decimal(12, 2)
  /// Set when this sale reverses another. A refund is never loose cash.
  refundsSaleId String?
  note          String?
  soldAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  org             Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location        Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  soldBy          User?               @relation("CounterSaleSeller", fields: [soldByUserId], references: [id], onDelete: SetNull)
  tillSession     TillSession?        @relation(fields: [tillSessionId], references: [id], onDelete: SetNull)
  refundsSale     CounterSale?        @relation("SaleRefund", fields: [refundsSaleId], references: [id], onDelete: SetNull)
  refundedBy      CounterSale[]       @relation("SaleRefund")
  lines           CounterSaleLine[]
  tenders         CounterSaleTender[]
  giftCardEntries GiftCardEntry[]

  @@unique([orgId, reference])
  @@index([orgId, status])
  @@index([orgId, soldAt])
  @@map("counter_sales")
}

model CounterSaleLine {
  id          String   @id @default(cuid())
  saleId      String
  /// Null for a one-off item or a service with nothing on the shelf.
  productId   String?
  kind        LineKind
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  /// Weighted average at the moment of sale, frozen here. Recomputing later
  /// would change what a sale in March cost when a delivery arrives in June.
  unitCost    Decimal  @default(0) @db.Decimal(12, 4)
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  taxRateId   String?
  taxAmount   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)

  sale    CounterSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)
  taxRate TaxRate?    @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@map("counter_sale_lines")
}

model CounterSaleTender {
  id        String     @id @default(cuid())
  saleId    String
  kind      TenderKind
  amount    Decimal    @db.Decimal(12, 2)
  reference String?
  createdAt DateTime   @default(now())

  sale CounterSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("counter_sale_tenders")
}

/// A day at the till. Opened with a float, closed with a count, and the
/// variance between the two is reported rather than absorbed.
model TillSession {
  id             String    @id @default(cuid())
  orgId          String
  locationId     String?
  openedByUserId String?
  openingFloat   Decimal   @default(0) @db.Decimal(12, 2)
  countedCash    Decimal?  @db.Decimal(12, 2)
  /// Cash taken out during the day: a supplier paid in cash, a float lifted.
  paidOut        Decimal   @default(0) @db.Decimal(12, 2)
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  note           String?

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  openedBy User?         @relation("TillOperator", fields: [openedByUserId], references: [id], onDelete: SetNull)
  sales    CounterSale[]

  @@index([orgId, openedAt])
  @@map("till_sessions")
}

/**
 * ===========================================================================
 * EXPENSES AND BANKING — Phase 4.8
 * The ledger balances against itself. Reconciliation is what makes it balance
 * against reality: until the bank agrees, a trial balance proves the
 * arithmetic was consistent, not that it was right.
 * ===========================================================================
 */

enum ExpenseCategory {
  PREMISES
  UTILITIES
  INSURANCE
  VEHICLE
  EQUIPMENT
  CONSUMABLES
  MARKETING
  PROFESSIONAL
  TRAINING
  SUBSCRIPTIONS
  OTHER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  REJECTED
}

enum PaidFrom {
  BANK
  CASH
  PERSONAL
  CARD
}

/// Money out that is not a supplier bill. Until this existed these were
/// hand-written journal entries, which works exactly as long as the person
/// writing them knows double-entry.
model Expense {
  id                  String          @id @default(cuid())
  orgId               String
  locationId          String?
  reference           String
  category            ExpenseCategory
  status              ExpenseStatus   @default(DRAFT)
  supplier            String
  description         String?
  net                 Decimal         @db.Decimal(12, 2)
  tax                 Decimal         @default(0) @db.Decimal(12, 2)
  incurredAt          DateTime
  paidFrom            PaidFrom        @default(BANK)
  /// A photograph or PDF. Required above a threshold, because an overhead
  /// figure built on remembered amounts cannot be defended to anybody.
  receiptUrl          String?
  /// Set when somebody spent their own money and is owed it back.
  claimedByEmployeeId String?
  approvedByUserId    String?
  approvedAt          DateTime?
  paidAt              DateTime?
  rejectedReason      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location   Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  claimedBy  Employee?    @relation("ExpenseClaimant", fields: [claimedByEmployeeId], references: [id], onDelete: SetNull)
  approvedBy User?        @relation("ExpenseApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([orgId, reference])
  @@index([orgId, status])
  @@index([orgId, incurredAt])
  @@map("expenses")
}

model BankAccount {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  /// Last four digits only. The full number is never needed here and storing
  /// it turns a workshop database into something worth stealing.
  last4       String?
  sortCode    String?
  /// Which ledger account this maps to, so a reconciliation knows what to
  /// compare against.
  accountCode String   @default("1000")
  currency    String   @default("GBP")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  statements BankStatement[]

  @@unique([orgId, name])
  @@map("bank_accounts")
}

model BankStatement {
  id             String   @id @default(cuid())
  bankAccountId  String
  startsOn       DateTime
  endsOn         DateTime
  openingBalance Decimal  @db.Decimal(14, 2)
  closingBalance Decimal  @db.Decimal(14, 2)
  importedAt     DateTime @default(now())

  account BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  lines   BankStatementLine[]

  @@index([bankAccountId, startsOn])
  @@map("bank_statements")
}

model BankStatementLine {
  id             String    @id @default(cuid())
  statementId    String
  postedOn       DateTime
  description    String
  reference      String?
  /// Positive is money in, negative is money out.
  amount         Decimal   @db.Decimal(14, 2)
  /// The journal entry this was matched to, once somebody accepted it.
  matchedEntryId String?
  matchedAt      DateTime?
  /// How the match was arrived at, kept so a reviewer can see the reasoning
  /// rather than only the result.
  matchReason    String?

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId, postedOn])
  @@index([matchedEntryId])
  @@map("bank_statement_lines")
}

/**
 * ===========================================================================
 * Automation and CRM (Phase 5)
 * ===========================================================================
 */

/// A rule is trigger, conditions and actions. Deliberately not a graph: a rule
/// cannot trigger a rule, because chained automation is impossible to reason
/// about after the third link and impossible to debug at all.
model AutomationRule {
  id            String   @id @default(cuid())
  orgId         String
  name          String
  trigger       String
  /// Every condition must hold. Stored as written so the sentence shown on the
  /// page and the sentence evaluated are the same object.
  conditions    Json     @default("[]")
  actions       Json
  isActive      Boolean  @default(true)
  /// The same subject cannot be acted on again inside this window. The floor
  /// is one hour and it is enforced in the database, not only in code.
  cooldownHours Int      @default(24)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org  Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@unique([orgId, name])
  @@index([orgId, trigger, isActive])
  @@map("automation_rules")
}

/// One firing, against one subject. Written whether or not anything was sent,
/// because "why did this not fire" is the question people actually ask.
model AutomationRun {
  id          String   @id @default(cuid())
  ruleId      String
  /// The thing the rule fired about: a job, an invoice, a vehicle.
  subjectType String
  subjectId   String
  /// The customer the actions reach, when there is one.
  customerId  String?
  firedAt     DateTime @default(now())
  /// Empty when it fired. Filled with the reason when it did not, so the page
  /// can show a rule that is quietly doing nothing.
  blockedBy   String?
  reason      String?

  rule    AutomationRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  actions AutomationAction[]

  @@index([ruleId, firedAt])
  @@index([ruleId, subjectType, subjectId, firedAt])
  @@map("automation_runs")
}

enum AutomationActionStatus {
  PENDING
  DONE
  FAILED
  CANCELLED
}

/// A scheduled action, waiting for its delay to elapse. Kept as a row rather
/// than a timer so a restart does not lose it and a person can see what is
/// about to happen and stop it.
model AutomationAction {
  id        String                 @id @default(cuid())
  runId     String
  kind      String
  target    String
  dueAt     DateTime
  status    AutomationActionStatus @default(PENDING)
  doneAt    DateTime?
  error     String?
  /// The message this became, once it was sent.
  messageId String?

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([runId])
  @@map("automation_actions")
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  CANCELLED
}

/// A segment and a message. The segment is stored as its rules rather than as
/// a list of people, because a list goes stale and consent withdrawn on
/// Tuesday must stop Wednesday's send.
model Campaign {
  id                String         @id @default(cuid())
  orgId             String
  name              String
  channel           MessageChannel
  segment           Json
  subject           String?
  body              String
  status            CampaignStatus @default(DRAFT)
  /// What the plan said when somebody pressed send, kept because a campaign
  /// cannot be undone and the count is the thing they were shown.
  plannedRecipients Int?
  plannedSuppressed Int?
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  org        Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([orgId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  customerId String
  /// SENT, or SUPPRESSED with the reason it was held back. Suppressions are
  /// kept, not discarded: the gap between the list and the send is the number
  /// worth knowing.
  status     String
  reason     String?
  sentAt     DateTime?
  messageId  String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

enum ConsentSource {
  SIGNUP
  PORTAL
  STAFF
  IMPORT
  UNSUBSCRIBE
}

/// Every change to a marketing permission, kept forever.
///
/// Consent is only worth anything if you can show when it was given and by
/// what route. A boolean on a customer row proves nothing: it shows the
/// current state and no history, and the one time it matters is the time
/// somebody asks how you came to have it. Written by a database trigger, so a
/// flag cannot be flipped without the trail.
model ConsentChange {
  id         String         @id @default(cuid())
  customerId String
  channel    MessageChannel
  granted    Boolean
  source     ConsentSource  @default(STAFF)
  /// Who did it, when a person did.
  actorId    String?
  note       String?
  changedAt  DateTime       @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, changedAt])
  @@map("consent_changes")
}

/**
 * ===========================================================================
 * Warranty (Phase 9)
 * ===========================================================================
 */

enum CoverKind {
  PART
  LABOUR
}

/// What a workshop stands behind, and for how long.
///
/// Cover runs from the day the work was done, not the day the part was sold,
/// and it runs out two ways: a period and a distance, whichever comes first. A
/// van reaches twenty thousand miles in five months, so a check that reads
/// only the calendar gives away a year of free parts.
model Warranty {
  id             String    @id @default(cuid())
  orgId          String
  jobId          String
  vehicleId      String
  kind           CoverKind
  description    String
  /// The part it covers, where it covers one.
  productId      String?
  /// When the work was done. Cover is measured from here.
  startedOn      DateTime
  months         Int
  /// Mileage allowance, where the warranty has one.
  km             Int?
  /// The odometer at fitting, needed to measure distance since.
  startedAtKm    Int?
  /// What the customer was charged, split because a supplier warrants the
  /// component and never the hour spent fitting it again.
  partsValue     Decimal   @default(0) @db.Decimal(12, 2)
  labourValue    Decimal   @default(0) @db.Decimal(12, 2)
  /// The supplier standing behind it, and for how long. This is what turns a
  /// goodwill repair into a recoverable one.
  supplierId     String?
  supplierMonths Int?
  /// Set when somebody voids it. The reason is required by a check
  /// constraint: a warranty that stopped applying for no stated reason is
  /// indistinguishable from one somebody cancelled to avoid a claim.
  voidedAt       DateTime?
  voidedReason   String?
  voidedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  vehicle  Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplier Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  voidedBy User?           @relation(fields: [voidedByUserId], references: [id], onDelete: SetNull)
  claims   WarrantyClaim[]

  @@index([orgId, startedOn])
  @@index([vehicleId])
  @@index([jobId])
  @@map("warranties")
}

enum ClaimStatus {
  OPEN
  ACCEPTED
  REJECTED
  SETTLED
}

/// Somebody saying the work did not hold.
///
/// A claim can be raised against expired cover, because a workshop does settle
/// those out of goodwill and that decision is worth recording rather than
/// hiding. What the database insists on is that a goodwill claim says why.
model WarrantyClaim {
  id             String      @id @default(cuid())
  warrantyId     String
  status         ClaimStatus @default(OPEN)
  /// What the customer reported.
  complaint      String
  /// Why it is being entertained at all, when cover had run out.
  goodwillReason String?
  /// True when the cover had already expired at the moment it was raised.
  outsideCover   Boolean     @default(false)
  /// What the workshop expects to carry once the supplier has paid whatever
  /// they will. Recorded at the time, because supplier cover moves on.
  exposure       Decimal     @default(0) @db.Decimal(12, 2)
  recoverable    Decimal     @default(0) @db.Decimal(12, 2)
  /// Set when the supplier has been asked, and what they said.
  supplierRef    String?
  outcome        String?
  raisedByUserId String?
  raisedAt       DateTime    @default(now())
  settledAt      DateTime?
  /// The job that put it right, where one was raised.
  remedyJobId    String?

  warranty  Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  raisedBy  User?    @relation(fields: [raisedByUserId], references: [id], onDelete: SetNull)
  remedyJob Job?     @relation("ClaimRemedy", fields: [remedyJobId], references: [id], onDelete: SetNull)

  @@index([warrantyId, raisedAt])
  @@index([status])
  @@map("warranty_claims")
}

/// Money taken in advance for work not yet chosen. A liability until it is
/// spent, never revenue on the day it is sold. Phase 26.
model GiftCard {
  id    String @id @default(cuid())
  orgId String

  /// Said out loud or read off a card, so no character that gets misheard.
  code String

  /// What was loaded on it when sold. The balance is the sum of the entries.
  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("GBP")
  /// How the buyer paid for it. Never points, never another card.
  method   PaymentMethod @default(CARD)

  buyerCustomerId String?
  recipientName   String?
  note            String?

  soldAt       DateTime @default(now())
  soldByUserId String?

  /// Optional. A card that lapses is money paid for nothing, so most never do.
  expiresAt  DateTime?
  /// Good at one site, or everywhere when null.
  locationId String?

  /// Cancelled, with the balance written off and the reason kept.
  disabledAt     DateTime?
  disabledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  buyer    Customer?       @relation(fields: [buyerCustomerId], references: [id], onDelete: SetNull)
  soldBy   User?           @relation(fields: [soldByUserId], references: [id], onDelete: SetNull)
  location Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  entries  GiftCardEntry[]

  @@unique([orgId, code])
  @@index([orgId, soldAt])
  @@map("gift_cards")
}

/// One movement on a card. Positive when loaded, negative when spent.
model GiftCardEntry {
  id         String @id @default(cuid())
  orgId      String
  giftCardId String

  /// Typed, so a balance can be explained: what was loaded, what was spent,
  /// what came back, and what a person changed by hand.
  kind   GiftCardEntryKind
  amount Decimal           @db.Decimal(12, 2)
  reason String

  /// The payment a redemption became, and the invoice or counter sale it went against.
  paymentId     String?
  invoiceId     String?
  counterSaleId String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  giftCard    GiftCard     @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  counterSale CounterSale? @relation(fields: [counterSaleId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([giftCardId, createdAt])
  @@index([orgId, createdAt])
  @@map("gift_card_entries")
}

enum GiftCardEntryKind {
  ISSUE
  REDEEM
  REFUND
  ADJUSTMENT
}

enum DepositKind {
  DEPOSIT
  CREDIT
}

/// Money held for a customer: a deposit taken before the work, or a credit
/// kept on account after a refund. A liability until it goes against an
/// invoice or back to the customer. Phase 30.
model Deposit {
  id         String      @id @default(cuid())
  orgId      String
  customerId String
  jobId      String?
  kind       DepositKind @default(DEPOSIT)

  amount         Decimal @db.Decimal(12, 2)
  /// What has gone against invoices, and what has gone back. Held is the rest.
  appliedAmount  Decimal @default(0) @db.Decimal(12, 2)
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)
  currency       String  @default("GBP")

  /// How it arrived. For a credit, the refund it came from.
  method         PaymentMethod @default(CARD)
  reference      String?
  note           String?
  receivedAt     DateTime      @default(now())
  takenByUserId  String?
  sourceRefundId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job          Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  takenBy      User?             @relation("DepositTaker", fields: [takenByUserId], references: [id], onDelete: SetNull)
  sourceRefund Refund?           @relation(fields: [sourceRefundId], references: [id], onDelete: SetNull)
  movements    DepositMovement[]

  @@index([orgId, customerId])
  @@index([orgId, receivedAt])
  @@map("deposits")
}

/// One movement of money held: negative when it goes against a bill or
/// back to the customer. The taking itself is the deposit row.
model DepositMovement {
  id        String @id @default(cuid())
  orgId     String
  depositId String

  amount Decimal @db.Decimal(12, 2)
  reason String

  paymentId String?
  invoiceId String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deposit   Deposit      @relation(fields: [depositId], references: [id], onDelete: Cascade)
  payment   Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoice   Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([depositId, createdAt])
  @@map("deposit_movements")
}

/// One try at paying some of an invoice through a provider. Phase 32.
/// Pending, then succeeded, failed or cancelled, once; a succeeded attempt
/// produces the Payment exactly once. The provider's own record is kept in
/// providerPayload (the stub's memory; a real provider is asked instead).
model PaymentAttempt {
  id              String               @id @default(cuid())
  orgId           String
  invoiceId       String
  customerId      String
  provider        String
  providerRef     String               @unique
  status          PaymentAttemptStatus @default(PENDING)
  amount          Decimal              @db.Decimal(12, 2)
  currency        String
  failureReason   String?
  checkoutUrl     String?
  returnUrl       String
  cancelUrl       String
  paymentId       String?              @unique
  settledAt       DateTime?
  checkedAt       DateTime?
  providerPayload Json?
  startedByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice   Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer  Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payment   Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  startedBy User?        @relation("PaymentAttemptStarter", fields: [startedByUserId], references: [id], onDelete: SetNull)
  refunds   Refund[]

  @@index([orgId, createdAt])
  @@index([invoiceId])
  @@map("payment_attempts")
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// A file somebody brought from another system, and what became of it. Phase 33.
/// The rows are kept as they arrived so the mapping can be changed and the
/// preview re-run; the report says, row by row, what did not go in and why.
model ImportBatch {
  id              String       @id @default(cuid())
  orgId           String
  dataset         String
  fileName        String
  delimiter       String       @default(",")
  headers         Json
  rows            Json
  rowCount        Int
  mapping         Json?
  status          ImportStatus @default(UPLOADED)
  report          Json?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  importedAt      DateTime?

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@map("import_batches")
}

enum ImportStatus {
  UPLOADED
  MAPPED
  IMPORTED
}
