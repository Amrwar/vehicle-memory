{
  "name": "carnet",
  "version": "0.1.0",
  "private": true,
  "description": "Carnet — a portable vehicle history that follows the car, with a workshop management and ERP platform built on top of it.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@carnet/web",
    "build": "npm run build --workspace=@carnet/db && npm run build --workspace=@carnet/core && npm run build --workspace=@carnet/web",
    "start": "npm run start --workspace=@carnet/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "typecheck": "tsc --build --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "npm run generate --workspace=@carnet/db",
    "db:migrate": "npm run migrate --workspace=@carnet/db",
    "db:deploy": "npm run deploy --workspace=@carnet/db",
    "db:seed": "npm run seed --workspace=@carnet/db",
    "db:reset": "npm run reset --workspace=@carnet/db",
    "db:studio": "npm run studio --workspace=@carnet/db",
    "worker": "npm run dev --workspace=@carnet/worker",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
