{
  "name": "carnet",
  "version": "0.1.0",
  "private": true,
  "description": "Carnet — a portable vehicle history that follows the car, with a workshop management and ERP platform built on top of it.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@carnet/web",
    "build": "npm run build --workspace=@carnet/db && npm run build --workspace=@carnet/core && npm run build --workspace=@carnet/web",
    "start": "npm run start --workspace=@carnet/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "typecheck": "tsc --build --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:theme": "tsx infra/scripts/audit-theme.ts",
    "verify:integrity": "tsx infra/scripts/verify-integrity.ts",
    "verify:inventory": "tsx infra/scripts/verify-inventory.ts",
    "verify:ledger": "tsx infra/scripts/verify-ledger.ts",
    "verify:signup": "tsx infra/scripts/verify-signup.ts",
    "verify:team": "tsx infra/scripts/verify-team.ts",
    "verify:counter": "tsx infra/scripts/verify-counter.ts",
    "verify:coupons": "tsx infra/scripts/verify-coupons.ts",
    "verify:repeat": "tsx infra/scripts/verify-repeat.ts",
    "verify:writes": "tsx infra/scripts/verify-writes.ts",
    "verify:wiring": "tsx infra/scripts/verify-wiring.ts",
    "verify:triggers": "tsx infra/scripts/verify-triggers.ts",
    "verify:books": "tsx infra/scripts/verify-books.ts",
    "verify:tenancy": "tsx infra/scripts/verify-tenancy.ts",
    "verify:banking": "tsx infra/scripts/verify-banking.ts",
    "verify:automation": "tsx infra/scripts/verify-automation.ts",
    "verify:messaging": "tsx infra/scripts/verify-messaging.ts",
    "verify:inspection": "tsx infra/scripts/verify-inspection.ts",
    "verify:controls": "tsx infra/scripts/verify-controls.ts",
    "verify:storage": "tsx infra/scripts/verify-storage.ts",
    "verify:warranty": "tsx infra/scripts/verify-warranty.ts",
    "verify:condition": "tsx infra/scripts/verify-condition.ts",
    "verify:handover": "tsx infra/scripts/verify-handover.ts",
    "verify:planning": "tsx infra/scripts/verify-planning.ts",
    "verify:provenance": "tsx infra/scripts/verify-provenance.ts",
    "verify:offline": "tsx infra/scripts/verify-offline.ts",
    "verify:retention": "tsx infra/scripts/verify-retention.ts",
    "verify:loyalty": "tsx infra/scripts/verify-loyalty.ts",
    "verify:referrals": "tsx infra/scripts/verify-referrals.ts",
    "verify:giftcards": "tsx infra/scripts/verify-giftcards.ts",
    "verify:region": "tsx infra/scripts/verify-region.ts",
    "verify:deposits": "tsx infra/scripts/verify-deposits.ts",
    "verify:authz": "tsx infra/scripts/verify-authz.ts",
    "verify:payments": "tsx infra/scripts/verify-payments.ts",
    "verify:billing": "tsx infra/scripts/verify-billing.ts",
    "verify:portal-account": "tsx infra/scripts/verify-portal-account.ts",
    "verify:import": "tsx infra/scripts/verify-import.ts",
    "verify:workflow": "tsx infra/scripts/verify-workflow.ts",
    "verify:arrival": "tsx infra/scripts/verify-arrival.ts",
    "verify:conversations": "tsx infra/scripts/verify-conversations.ts",
    "verify:packages": "tsx infra/scripts/verify-packages.ts",
    "verify:languages": "tsx infra/scripts/verify-languages.ts",
    "verify:returns": "tsx infra/scripts/verify-returns.ts",
    "verify:search": "tsx infra/scripts/verify-search.ts",
    "verify:owner": "tsx infra/scripts/verify-owner.ts",
    "verify:tax": "tsx infra/scripts/verify-tax.ts",
    "verify:paper": "tsx infra/scripts/verify-paper.ts",
    "verify:providers": "tsx infra/scripts/verify-providers.ts",
    "verify:ownership": "tsx infra/scripts/verify-ownership.ts",
    "verify:first-day": "tsx infra/scripts/verify-first-day.ts",
    "verify:screens": "tsx infra/scripts/verify-screens.ts",
    "verify:passports": "tsx infra/scripts/verify-passports.ts",
    "verify:credentials": "tsx infra/scripts/verify-credentials.ts",
    "verify:deliverability": "tsx infra/scripts/verify-deliverability.ts",
    "verify:claims": "tsx infra/scripts/verify-claims.ts",
    "verify:records": "tsx infra/scripts/verify-records.ts",
    "verify:money": "tsx infra/scripts/verify-money.ts",
    "verify:erp": "tsx infra/scripts/verify-erp.ts",
    "verify:answers": "tsx infra/scripts/verify-answers.ts",
    "verify:network": "tsx --tsconfig apps/web/tsconfig.json infra/scripts/verify-network.ts",
    "verify:settings": "tsx infra/scripts/verify-settings.ts",
    "verify:documents": "tsx infra/scripts/verify-documents.ts",
    "verify:headers": "tsx infra/scripts/verify-headers.ts",
    "verify:backup": "tsx infra/scripts/verify-backup.ts",
    "verify:hardening": "tsx infra/scripts/verify-hardening.ts",
    "verify:assistant": "tsx infra/scripts/verify-assistant.ts",
    "docs:openapi": "tsx --tsconfig apps/web/tsconfig.json infra/scripts/build-openapi.ts",
    "docs:openapi:check": "tsx --tsconfig apps/web/tsconfig.json infra/scripts/build-openapi.ts --check",
    "docs:deck": "python infra/scripts/build_deck.py",
    "docs:business-case": "python infra/scripts/update-business-case.py",
    "docs:shots": "tsx infra/scripts/design-shots.ts",
    "docs:design-book": "python infra/scripts/build_design_book.py",
    "docs:diagrams": "tsx infra/scripts/architecture-diagrams.ts",
    "docs:architecture": "python infra/scripts/build_architecture_doc.py",
    "docs:workflows": "tsx infra/scripts/build-workflows-doc.ts",
    "docs:all": "npm run docs:workflows && npm run docs:deck && npm run docs:business-case && npm run docs:design-book && npm run docs:diagrams && npm run docs:architecture",
    "verify:empty": "tsx infra/scripts/verify-empty.ts",
    "verify:access": "tsx infra/scripts/verify-access.ts",
    "smoke": "tsx infra/scripts/smoke.ts",
    "timings": "tsx infra/scripts/timings.ts",
    "db:generate": "npm run generate --workspace=@carnet/db",
    "db:migrate": "npm run migrate --workspace=@carnet/db",
    "db:deploy": "npm run deploy --workspace=@carnet/db",
    "db:seed": "npm run seed --workspace=@carnet/db",
    "db:reset": "npm run reset --workspace=@carnet/db",
    "db:studio": "npm run studio --workspace=@carnet/db",
    "worker": "npm run dev --workspace=@carnet/worker",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run audit:theme",
    "prepare": "husky || true",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
