# ---------------------------------------------------------------------------
# Carnet — environment template
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Carnet
# Optional on Vercel: derived from VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL
# when unset, so preview deployments link to themselves. Set it once you
# have a real domain.
APP_URL=http://localhost:3000
PORT=3000

# --- Database ---------------------------------------------------------------
# Local docker-compose default. Change the password outside local development.
DATABASE_URL=postgresql://carnet:carnet@localhost:5432/carnet?schema=public
# Optional direct (non-pooled) connection used by migrations in serverless envs
DIRECT_DATABASE_URL=

# --- Redis (queues, rate limiting) ------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# 32+ byte random string. Generate: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-secret-value-min-32-chars
SESSION_TTL_HOURS=12

# --- Vehicle passport -------------------------------------------------------
# Salt used when deriving the tamper-evident event chain. Rotating it breaks
# verification of previously written events — treat as append-only.
LEDGER_CHAIN_SALT=replace-me-ledger-salt

# --- Scheduled work ---------------------------------------------------------
# The background jobs run as scheduled requests in production, because the
# application is hosted somewhere that cannot hold a polling loop open. The
# routes refuse everything without this, so a deployment that forgets it does
# nothing rather than exposing them.
#
# Locally you do not need it: `npm run worker` runs the same jobs in a loop.
#
# On Vercel's Hobby tier a cron may run once a day and no more, so the schedule
# in vercel.json is daily and the real driver is the Dispatch workflow in
# .github/workflows, which calls the same routes every ten minutes for nothing.
# Set CRON_SECRET as a repository secret and SITE_URL as a repository variable
# for that to work. On Pro, turn the schedule in vercel.json back up and delete
# the workflow.
CRON_SECRET=

# --- Outbound messaging -----------------------------------------------------
# Read by the worker, which is the only thing in the product that hands a
# message to a provider. Everything else writes a row to message_logs.
#
# "console" is a real transport, not a no-op: it writes the message to the log
# and reports success, so the queue drains and every state after sending can be
# exercised without an account. It is also the default, which means a
# deployment that has not been told how to send will say "console" in its
# start-up line rather than silently dropping a workshop's reminders.
MAIL_TRANSPORT=console          # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Carnet <no-reply@carnet.local>"

SMS_TRANSPORT=console           # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- File storage -----------------------------------------------------------
# Inspection photographs. "local" writes to disk and is for development only:
# a serverless host discards its disk between requests, and a photograph that
# disappears silently is worse than one never taken.
#
# "s3" speaks the S3 API, which Cloudflare R2, Amazon S3, Backblaze and MinIO
# all understand, so the vendor is a URL and two keys rather than a code
# change. R2 is the recommendation, because inspection photographs are read far
# more often than written and R2 charges nothing for egress.
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_PATH=.storage

S3_ENDPOINT=                    # https://<account>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto                  # R2 ignores it; S3 needs a real one
S3_FORCE_PATH_STYLE=true        # false for Amazon S3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=debug                 # trace | debug | info | warn | error
SENTRY_DSN=

# --- Feature flags ----------------------------------------------------------
FEATURE_CUSTOMER_PORTAL=true
FEATURE_VEHICLE_PASSPORT=true
FEATURE_INVENTORY=false
FEATURE_ACCOUNTING=false

# Generated text is a port, like mail. "none" composes every customer summary
# from the record and is a complete feature. "anthropic" lets a model tidy the
# prose; its output is checked against the record before anybody sees it.
AI_TRANSPORT=none
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Card payments through a provider (Phase 32). stub takes pretend money at /pay/<attempt>;
# stripe needs the two keys. The stub's webhook is signed with PAYMENT_WEBHOOK_SECRET.
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=local-payment-webhook-secret-change-me
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# The provider's own recurring prices per plan (per bay, per month). Optional; without them the plan is priced inline.
# STRIPE_PRICE_CORE=price_...
# STRIPE_PRICE_COMPLETE=price_...
# STRIPE_PRICE_GROUP=price_...

# Providers behind seams (Phase 43).
# stub reads the maker and year from the VIN alone; nhtsa asks the US registry's free decoder.
VIN_DECODER=stub
# sample knows the demonstration parts only; none hides "Fetch from the catalogue".
FITMENT_FEED=sample
# Where a customer who gave five stars is sent, once the workshop names its Google listing.
REVIEW_SITE=google
