# ---------------------------------------------------------------------------
# Carnet — environment template
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Carnet
APP_URL=http://localhost:3000
PORT=3000

# --- Database ---------------------------------------------------------------
# Local docker-compose default. Change the password outside local development.
DATABASE_URL=postgresql://carnet:carnet@localhost:5432/carnet?schema=public
# Optional direct (non-pooled) connection used by migrations in serverless envs
DIRECT_DATABASE_URL=

# --- Redis (queues, rate limiting) ------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# 32+ byte random string. Generate: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-secret-value-min-32-chars
SESSION_TTL_HOURS=12

# --- Vehicle passport -------------------------------------------------------
# Salt used when deriving the tamper-evident event chain. Rotating it breaks
# verification of previously written events — treat as append-only.
LEDGER_CHAIN_SALT=replace-me-ledger-salt

# --- Outbound messaging (optional in development) ---------------------------
MAIL_TRANSPORT=console          # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Carnet <no-reply@carnet.local>"

SMS_TRANSPORT=console           # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- File storage -----------------------------------------------------------
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_PATH=.storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=debug                 # trace | debug | info | warn | error
SENTRY_DSN=

# --- Feature flags ----------------------------------------------------------
FEATURE_CUSTOMER_PORTAL=true
FEATURE_VEHICLE_PASSPORT=true
FEATURE_INVENTORY=false
FEATURE_ACCOUNTING=false
